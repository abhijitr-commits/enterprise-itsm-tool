<%- include('../partials/header', { title: 'Shifts & Roster' }) %>

<div class="page-header">
  <h1>Shifts &amp; Roster</h1>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<form class="filter-bar" method="get" action="/shifts">
  <label class="hint">From <input type="date" name="startDate" value="<%= range.startDate %>" /></label>
  <label class="hint">To <input type="date" name="endDate" value="<%= range.endDate %>" /></label>
  <button type="submit" class="btn btn-secondary">Show</button>
</form>

<div class="detail-grid">
  <div>
    <div class="panel">
      <div class="panel-header"><h2>Roster (<%= range.startDate %> – <%= range.endDate %>)</h2></div>
      <table class="table">
        <thead><tr><th>Date</th><th>Employee</th><th>Shift</th></tr></thead>
        <tbody>
          <% roster.forEach(function(r) { %>
            <tr><td><%= r.date %></td><td><%= r.employee %></td><td><%= r.shiftName %></td></tr>
          <% }) %>
          <% if (roster.length === 0) { %><tr><td colspan="3" class="empty-row">No roster entries in this range.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <div class="panel">
      <div class="panel-header"><h2>Shifts</h2></div>
      <table class="table">
        <thead><tr><th>Name</th><th>Start</th><th>End</th></tr></thead>
        <tbody>
          <% shifts.forEach(function(s) { %>
            <tr><td><%= s.shiftName %></td><td><%= s.startTime %></td><td><%= s.endTime %></td></tr>
          <% }) %>
          <% if (shifts.length === 0) { %><tr><td colspan="3" class="empty-row">No shifts defined yet.</td></tr><% } %>
        </tbody>
      </table>
      <form method="post" action="/shifts" class="form-panel">
        <div class="form-grid">
          <label>Shift Name <input type="text" name="shiftName" required /></label>
          <label>Start Time <input type="time" name="startTime" /></label>
          <label>End Time <input type="time" name="endTime" /></label>
        </div>
        <button type="submit" class="btn btn-secondary">Add Shift</button>
      </form>
    </div>

    <div class="panel">
      <div class="panel-header"><h2>Assign Shift</h2></div>
      <form method="post" action="/shifts/roster" class="form-panel">
        <input type="hidden" name="rangeStart" value="<%= range.startDate %>" />
        <input type="hidden" name="rangeEnd" value="<%= range.endDate %>" />
        <div class="form-grid">
          <label>Employee <input type="text" name="employee" required /></label>
          <label>Shift
            <select name="shiftId" required>
              <option value="">Select…</option>
              <% shifts.forEach(function(s) { %>
                <option value="<%= s.shiftId %>"><%= s.shiftName %> (<%= s.startTime %>-<%= s.endTime %>)</option>
              <% }) %>
            </select>
          </label>
          <label>Date <input type="date" name="date" required /></label>
        </div>
        <button type="submit" class="btn btn-secondary">Assign</button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
