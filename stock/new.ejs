<%- include('../partials/header', { title: 'Add Stock Item' }) %>

<div class="page-header">
  <h1>Add Stock Item</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form class="panel form-panel" method="post" action="/stock">
  <div class="form-grid">
    <label>Item Name
      <input type="text" name="itemName" value="<%= form.itemName || '' %>" required />
    </label>
    <label>Category
      <input type="text" name="category" value="<%= form.category || '' %>" placeholder="General" />
    </label>
    <label>Unit
      <input type="text" name="unit" value="<%= form.unit || '' %>" placeholder="pcs" />
    </label>
    <label>Opening Stock
      <input type="number" name="openingStock" min="0" value="<%= form.openingStock || 0 %>" />
    </label>
    <label>Reorder Level
      <input type="number" name="reorderLevel" min="0" value="<%= form.reorderLevel || 0 %>" />
    </label>
    <label>Location
      <input type="text" name="location" value="<%= form.location || '' %>" />
    </label>
  </div>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/stock">Cancel</a>
    <button type="submit" class="btn btn-primary">Save</button>
  </div>
</form>

<%- include('../partials/footer') %>
