<%- include('../partials/header', { title: 'New Article' }) %>

<div class="page-header">
  <h1>New Knowledge Base Article</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form class="panel form-panel" method="post" action="/knowledge">
  <div class="form-grid">
    <label>Category
      <input type="text" name="category" value="<%= form.category || '' %>" placeholder="e.g. Hardware, Software, Network, HR" />
    </label>
  </div>
  <label>Title
    <input type="text" name="title" value="<%= form.title || '' %>" required />
  </label>
  <label>Content
    <textarea name="content" rows="10" required><%= form.content || '' %></textarea>
  </label>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/knowledge">Cancel</a>
    <button type="submit" class="btn btn-primary">Publish Article</button>
  </div>
</form>

<%- include('../partials/footer') %>
