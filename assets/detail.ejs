<%- include('../partials/header', { title: asset.assetId }) %>

<div class="page-header">
  <h1><%= asset.assetId %> — <%= asset.assetName %></h1>
  <div class="header-actions">
    <% if (asset.status !== 'Decommissioned') { %>
      <form method="post" action="/assets/<%= asset._id %>/decommission" onsubmit="return confirm('Decommission this asset?')">
        <button class="btn btn-danger" type="submit">Decommission</button>
      </form>
    <% } %>
  </div>
</div>

<% if (justCreated) { %><div class="alert alert-success">Asset created successfully.</div><% } %>

<div class="detail-grid">
  <div>
    <form class="panel form-panel" method="post" action="/assets/<%= asset._id %>">
      <div class="form-grid">
        <label>Asset Name
          <input type="text" name="assetName" value="<%= asset.assetName %>" required />
        </label>
        <label>Type
          <input type="text" name="type" value="<%= asset.type %>" required />
        </label>
        <label>Serial Number
          <input type="text" name="serialNumber" value="<%= asset.serialNumber || '' %>" />
        </label>
        <label>Department
          <input type="text" name="department" value="<%= asset.department %>" required />
        </label>
        <label>Location
          <input type="text" name="location" value="<%= asset.location %>" required />
        </label>
        <label>Vendor
          <input type="text" name="vendor" value="<%= asset.vendor || '' %>" />
        </label>
        <label>Purchase Date
          <input type="date" name="purchaseDate" value="<%= asset.purchaseDate ? new Date(asset.purchaseDate).toISOString().slice(0,10) : '' %>" />
        </label>
        <label>Warranty Expiry
          <input type="date" name="warrantyExpiry" value="<%= asset.warrantyExpiry ? new Date(asset.warrantyExpiry).toISOString().slice(0,10) : '' %>" />
        </label>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>

    <div class="panel form-panel">
      <div class="panel-header"><h2>Assignment</h2></div>
      <p><strong>Currently assigned to:</strong> <%= asset.assignedTo || 'Unassigned' %> (<span class="badge badge-status-<%= asset.status.toLowerCase().replace(/ /g,'-') %>"><%= asset.status %></span>)</p>
      <% if (asset.assignedTo) { %>
        <form method="post" action="/assets/<%= asset._id %>/return" onsubmit="return confirm('Mark this asset as returned?')">
          <button class="btn btn-secondary" type="submit">Return Asset</button>
        </form>
      <% } else { %>
        <form method="post" action="/assets/<%= asset._id %>/issue" class="form-grid">
          <label>Issue To
            <input type="text" name="assignedTo" placeholder="Employee name" required />
          </label>
          <div class="form-actions" style="align-self:end">
            <button type="submit" class="btn btn-primary">Issue Asset</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header"><h2>Asset History</h2></div>
    <div class="comment-list">
      <% history.forEach(function(h) { %>
        <div class="comment">
          <div class="comment-meta"><%= new Date(h.date).toLocaleString() %> · <%= h.action %></div>
          <div class="comment-text"><%= h.from || '—' %> → <%= h.to || '—' %><% if (h.notes) { %> (<%= h.notes %>)<% } %></div>
        </div>
      <% }) %>
      <% if (history.length === 0) { %><p class="empty-row">No history yet.</p><% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
