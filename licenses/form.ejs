<%- include('../partials/header', { title: editing ? 'Edit License' : 'Add License' }) %>

<div class="page-header">
  <h1><%= editing ? 'Edit License' : 'Add License' %></h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form class="panel form-panel" method="post" action="<%= editing ? '/licenses/' + form._id : '/licenses' %>">
  <div class="form-grid">
    <label>Software Name
      <input type="text" name="softwareName" value="<%= form.softwareName || '' %>" required />
    </label>
    <label>Vendor
      <input type="text" name="vendor" value="<%= form.vendor || '' %>" />
    </label>
    <label>License Type
      <input type="text" name="licenseType" value="<%= form.licenseType || '' %>" placeholder="e.g. Per-seat, Site License" />
    </label>
    <label>Seats Total
      <input type="number" name="seatsTotal" min="0" value="<%= form.seatsTotal || 0 %>" />
    </label>
    <label>Seats Used
      <input type="number" name="seatsUsed" min="0" value="<%= form.seatsUsed || 0 %>" />
    </label>
    <label>Cost
      <input type="number" name="cost" min="0" step="0.01" value="<%= form.cost || '' %>" />
    </label>
    <label>Purchase Date
      <input type="date" name="purchaseDate" value="<%= form.purchaseDate ? new Date(form.purchaseDate).toISOString().slice(0,10) : '' %>" />
    </label>
    <label>Expiry Date
      <input type="date" name="expiryDate" value="<%= form.expiryDate ? new Date(form.expiryDate).toISOString().slice(0,10) : '' %>" />
    </label>
    <% if (editing) { %>
      <label>Status
        <select name="status">
          <option value="Active" <%= form.status === 'Active' ? 'selected' : '' %>>Active</option>
          <option value="Inactive" <%= form.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </label>
    <% } %>
  </div>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/licenses">Cancel</a>
    <button type="submit" class="btn btn-primary">Save</button>
  </div>
</form>

<%- include('../partials/footer') %>
