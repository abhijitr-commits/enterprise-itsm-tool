<%- include('../partials/header', { title: policy.policyName + ' — Compliance' }) %>

<div class="page-header">
  <h1><%= policy.policyName %> <span class="hint">Compliance Report</span></h1>
  <a class="btn btn-secondary" href="/policies">Back to Policies</a>
</div>

<div class="panel">
  <table class="table">
    <thead><tr><th>Employee</th><th>Department</th><th>Acknowledged</th></tr></thead>
    <tbody>
      <% rows.forEach(function(r) { %>
        <tr>
          <td><%= r.name %></td>
          <td><%= r.department %></td>
          <td><span class="badge <%= r.acknowledged ? 'badge-status-resolved' : 'badge-status-open' %>"><%= r.acknowledged ? 'Yes' : 'No' %></span></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %><tr><td colspan="3" class="empty-row">No active employees on record.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
