<%- include('../partials/header', { title: 'My Certificates' }) %>

<div class="page-header">
  <h1>My Certificates</h1>
</div>

<div class="panel">
  <table class="table">
    <thead><tr><th>Course</th><th>Issued</th><th></th></tr></thead>
    <tbody>
      <% certificates.forEach(function(c) { %>
        <tr>
          <td><%= c.courseTitle %></td>
          <td><%= new Date(c.issuedDate).toLocaleDateString() %></td>
          <td><a class="btn btn-secondary" href="/training/certificates/<%= c.certificateId %>">View / Print</a></td>
        </tr>
      <% }) %>
      <% if (certificates.length === 0) { %><tr><td colspan="3" class="empty-row">No certificates earned yet. Complete a course from the <a href="/training/courses">Training Catalog</a> to earn one.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
