<%- include('../partials/header', { title: 'Performance Goals' }) %>

<div class="page-header">
  <h1>Performance Goals</h1>
  <% if (isHR) { %><a class="btn btn-primary" href="/performance/goals/new">+ Set a Goal</a><% } %>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>ID</th><th>Employee</th><th>Goal</th><th>Target Date</th><th>Status</th><th>Progress</th><th></th></tr></thead>
    <tbody>
      <% goals.forEach(function(g) { %>
        <% const isOwner = g.employee.trim().toLowerCase() === currentUserName.trim().toLowerCase(); %>
        <tr>
          <td><%= g.goalId %></td>
          <td><%= g.employee %></td>
          <td><%= g.goalTitle %><% if (g.description) { %><div class="hint"><%= g.description %></div><% } %></td>
          <td><%= g.targetDate ? new Date(g.targetDate).toLocaleDateString() : '—' %></td>
          <td><span class="badge <%= g.status === 'Completed' ? 'badge-status-resolved' : g.status === 'In Progress' ? 'badge-status-in-progress' : 'badge-status-open' %>"><%= g.status %></span></td>
          <td><%= g.progress %>%</td>
          <td>
            <% if (isOwner || isHR) { %>
              <form method="post" action="/performance/goals/<%= g._id %>/progress" class="filter-bar">
                <input type="number" name="progress" min="0" max="100" value="<%= g.progress %>" style="width:70px" />
                <button type="submit" class="btn btn-secondary">Update</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (goals.length === 0) { %><tr><td colspan="7" class="empty-row">No goals set yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
