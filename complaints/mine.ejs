<%- include('../partials/header', { title: 'My Complaints' }) %>

<div class="page-header">
  <h1>My Complaints</h1>
  <a class="btn btn-primary" href="/complaints/new">+ File a Complaint</a>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>Complaint ID</th><th>Category</th><th>Subject</th><th>Status</th><th>Filed</th><th>Resolution Notes</th></tr></thead>
    <tbody>
      <% complaints.forEach(function(c) { %>
        <tr>
          <td><%= c.complaintId %></td>
          <td><%= c.category %></td>
          <td><%= c.subject %></td>
          <td><span class="badge <%= c.status === 'Open' ? 'badge-status-open' : (c.status === 'Resolved' || c.status === 'Closed' ? 'badge-status-resolved' : 'badge-status-in-progress') %>"><%= c.status %></span></td>
          <td><%= new Date(c.createdDate).toLocaleDateString() %></td>
          <td><%= c.resolutionNotes || '—' %></td>
        </tr>
      <% }) %>
      <% if (complaints.length === 0) { %><tr><td colspan="6" class="empty-row">You haven't filed any complaints.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
