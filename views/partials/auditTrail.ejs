<%
  // Shared partial — include with local: auditEntries (array, oldest
  // first, each with a populated .user {name} where available). Port
  // of RecordEngine.gs's getAuditTrailForRecord(id) display.
%>
<div class="panel">
  <div class="panel-header"><h2>Audit Trail</h2></div>
  <div class="timeline">
    <% (auditEntries || []).forEach(function(e) { %>
      <% var actorName = (e.user && e.user.name) || 'System'; %>
      <div class="timeline-item">
        <span class="avatar avatar-sm"><%= initials(actorName) %></span>
        <div class="timeline-content">
          <div class="timeline-meta"><strong><%= actorName %></strong> <span class="timeline-action"><%= e.action %></span><span class="timeline-time"><%= new Date(e.createdAt).toLocaleString() %></span></div>
          <% if (e.details) { %><div class="timeline-details"><%= typeof e.details === 'string' ? e.details : JSON.stringify(e.details) %></div><% } %>
        </div>
      </div>
    <% }) %>
    <% if ((auditEntries || []).length === 0) { %><p class="empty-row">No audit history yet.</p><% } %>
  </div>
</div>
