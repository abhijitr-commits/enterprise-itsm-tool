    </main>
  </div>
  <script>
    // Stamps the CSRF token (see the <meta name="csrf-token"> tag in
    // partials/header.ejs, and utils/csrf.js for the server-side check)
    // into every rendered <form method="post"> as a hidden _csrf field.
    // Done here, once, instead of hand-editing every form across ~115
    // view files — a form added later needs no special handling either,
    // as long as it's a real <form method="post">.
    (function () {
      var meta = document.querySelector('meta[name="csrf-token"]');
      var token = meta ? meta.getAttribute("content") : "";
      if (!token) return; // anonymous pages (login, /support) never get one — by design, see utils/csrf.js
      document.querySelectorAll("form").forEach(function (f) {
        if ((f.getAttribute("method") || "get").toLowerCase() !== "post") return;
        if (f.querySelector('input[name="_csrf"]')) return;
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token;
        f.appendChild(input);
      });
    })();

    // Each hub lives under one dropdown button in the top bar (see
    // partials/header.ejs's .nav-dropdown <details> elements) — this is
    // the only JS needed to make that feel like a normal menu: close any
    // other open dropdown when one opens, and close on an outside click.
    // Opening/closing itself is native <details>/<summary> behavior.
    (function () {
      var dropdowns = document.querySelectorAll(".nav-dropdown");
      dropdowns.forEach(function (d) {
        d.addEventListener("toggle", function () {
          if (d.open) {
            dropdowns.forEach(function (other) {
              if (other !== d) other.open = false;
            });
          }
        });
      });
      document.addEventListener("click", function (e) {
        dropdowns.forEach(function (d) {
          if (d.open && !d.contains(e.target)) d.open = false;
        });
      });
    })();

    // Flash messages (.alert-success / .alert-info only — these are always
    // transient post-redirect notices in this app's pattern) auto-dismiss
    // as a toast after a few seconds. .alert-error is left alone: it's
    // usually on a form the user is actively fixing and needs to keep
    // seeing until they resolve it themselves.
    (function () {
      var toasts = document.querySelectorAll(".alert-success, .alert-info");
      toasts.forEach(function (t) {
        setTimeout(function () {
          t.classList.add("alert-hide");
          t.addEventListener("animationend", function () { t.remove(); }, { once: true });
        }, 4000);
      });
    })();
  </script>
</body>
</html>
