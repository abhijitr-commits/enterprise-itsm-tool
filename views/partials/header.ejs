<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title + " · Enterprise ITSM" : "Enterprise ITSM" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" />
</head>
<body>
  <%
    // currentPath comes from src/middleware/auth.js's attachUser (set on
    // every request, res.locals.currentPath = req.path) — used here to
    // light up the right nav button / link for the page we're actually
    // on, without every controller having to pass it in.
    const cp = typeof currentPath !== "undefined" ? currentPath : "";
    const underPath = (p) => cp === p || cp.startsWith(p + "/");
    const anyUnder = (paths) => paths.some((p) => underPath(p));
    const topTabClass = (p) => "top-tab" + (underPath(p) ? " active" : "");
    const topTabClassAny = (paths) => "top-tab" + (anyUnder(paths) ? " active" : "");
    const panelLinkClass = (p) => "panel-link" + (underPath(p) ? " active" : "");
    const initials = (name) => String(name || "?").trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
  %>
  <div class="page-shell">
    <% if (currentUser) { %>
      <%
        // Port of Navigation.gs's moduleVisibility: hides a link entirely
        // when the signed-in user's role has zero permissions left for
        // that module (see src/middleware/moduleVisibility.js). Undefined
        // (e.g. no user yet) defaults every module to visible.
        const mv = typeof moduleVisibility !== "undefined" ? moduleVisibility : {};
        const canSee = (key) => mv[key] !== false;
        // HR-team / IT-team / Admin-team checks, same rule as
        // src/utils/teamAccess.js: Administrator always qualifies;
        // otherwise Manager + the matching department. Kept inline here
        // since header.ejs has no access to that module directly — just
        // display logic, the real gate is still server-side on every route.
        const isHRTeamUser = currentUser.role === 'Administrator' ||
          (currentUser.role === 'Manager' && String(currentUser.department || '').trim().toLowerCase() === 'hr');
        const isAdminTeamUser = currentUser.role === 'Administrator' ||
          (currentUser.role === 'Manager' && String(currentUser.department || '').trim().toLowerCase() === 'administration');
        const isITTeamUser = currentUser.role === 'Administrator' ||
          (currentUser.role === 'Manager' && String(currentUser.department || '').trim().toLowerCase() === 'it');
        const isManagerUp = currentUser.role === 'Administrator' || currentUser.role === 'Manager';
        const ITSM_PATHS = ['/incidents','/requests','/problems','/changes','/assets','/cmdb','/knowledge','/reports'];
        const HR_PATHS = ['/hr','/mywork','/profile','/orgchart','/employees','/leave','/attendance','/shifts','/resignations','/performance','/training','/policies','/documents','/onboarding','/recruitment','/referrals','/succession','/benefits','/letters','/system-policies'];
        const IT_PATHS = ['/it','/access-requests','/vendors','/purchases','/stock','/licenses','/rooms','/complaints','/expenses','/maintenance','/helpdesk','/asset-allocation','/it-clearance','/vendor-service','/requirements'];
        const OPS_PATHS = ['/operations','/safety','/sales','/work-orders','/engineering-changes','/shipments','/material-requests','/wellness'];
        const ADMIN_PATHS = ['/admin','/masterdata'];
        const anyItsm = canSee('incidents') || canSee('requests') || canSee('problems') || canSee('changes') || canSee('assets') || canSee('cmdb') || canSee('knowledge') || canSee('reports');
      %>
      <!-- Every department ("head") lives under exactly one button in this
           bar — click it to drop down that hub's full page list — instead
           of duplicating the same links again in a separate sidebar. -->
      <nav class="top-tabs">
        <a class="brand-inline" href="/">
          <span class="brand-mark"><%- icon('grid', {size:14}) %></span>
          <span class="brand-inline-text">Enterprise ITSM</span>
        </a>
        <a class="<%= cp === '/' ? 'top-tab active' : 'top-tab' %>" href="/"><%- icon('home') %> Dashboard</a>

        <% if (anyItsm) { %>
        <details class="nav-dropdown">
          <summary class="<%= topTabClassAny(ITSM_PATHS) %>"><%- icon('layers') %> ITSM<span class="chev"><%- icon('chevron-down', {size:13}) %></span></summary>
          <div class="nav-dropdown-panel">
            <% if (canSee('incidents')) { %><a href="/incidents" class="<%= panelLinkClass('/incidents') %>"><%- icon('alert-circle', {size:15}) %> Incidents</a><% } %>
            <% if (canSee('requests')) { %><a href="/requests" class="<%= panelLinkClass('/requests') %>"><%- icon('clipboard-check', {size:15}) %> Service Requests</a><% } %>
            <% if (canSee('problems')) { %><a href="/problems" class="<%= panelLinkClass('/problems') %>"><%- icon('alert-triangle', {size:15}) %> Problems</a><% } %>
            <% if (canSee('changes')) { %><a href="/changes" class="<%= panelLinkClass('/changes') %>"><%- icon('check-circle', {size:15}) %> Changes</a><% } %>
            <% if (canSee('assets')) { %><a href="/assets" class="<%= panelLinkClass('/assets') %>"><%- icon('monitor', {size:15}) %> Assets</a><% } %>
            <% if (canSee('cmdb')) { %><a href="/cmdb" class="<%= panelLinkClass('/cmdb') %>"><%- icon('grid', {size:15}) %> CMDB</a><% } %>
            <% if (canSee('knowledge')) { %><a href="/knowledge" class="<%= panelLinkClass('/knowledge') %>"><%- icon('layers', {size:15}) %> Knowledge Base</a><% } %>
            <% if (canSee('reports')) { %><a href="/reports" class="<%= panelLinkClass('/reports') %>"><%- icon('grid', {size:15}) %> Reports</a><% } %>
            <% if (isManagerUp) { %><a href="/reports/executive-summary" class="<%= panelLinkClass('/reports/executive-summary') %>"><%- icon('briefcase', {size:15}) %> Executive Summary</a><% } %>
          </div>
        </details>
        <% } %>

        <details class="nav-dropdown">
          <summary class="<%= topTabClassAny(HR_PATHS) %>"><%- icon('users') %> HR Hub<span class="chev"><%- icon('chevron-down', {size:13}) %></span></summary>
          <div class="nav-dropdown-panel nav-dropdown-panel-wide">
            <a href="/hr" class="panel-link hub-link">Hub Overview</a>
            <a href="/mywork" class="<%= panelLinkClass('/mywork') %>">My Work</a>
            <a href="/profile" class="<%= panelLinkClass('/profile') %>">My Profile</a>
            <a href="/orgchart" class="<%= panelLinkClass('/orgchart') %>">Org Chart</a>
            <a href="/employees" class="<%= panelLinkClass('/employees') %>">Employee Directory</a>
            <a href="/leave" class="<%= panelLinkClass('/leave') %>">Leave</a>
            <a href="/attendance" class="<%= panelLinkClass('/attendance') %>">Attendance</a>
            <a href="/shifts" class="<%= panelLinkClass('/shifts') %>">Shifts &amp; Roster</a>
            <a href="/resignations" class="<%= panelLinkClass('/resignations') %>">Resignations</a>
            <a href="/performance/goals" class="<%= panelLinkClass('/performance/goals') %>">Goals</a>
            <a href="/performance/reviews" class="<%= panelLinkClass('/performance/reviews') %>">Reviews</a>
            <a href="/training/courses" class="<%= panelLinkClass('/training/courses') %>">Training Catalog</a>
            <a href="/training/certificates" class="<%= panelLinkClass('/training/certificates') %>">My Certificates</a>
            <a href="/policies" class="<%= panelLinkClass('/policies') %>">IT Policies</a>
            <a href="/documents" class="<%= panelLinkClass('/documents') %>">My Documents</a>
            <% if (isHRTeamUser) { %>
              <a href="/onboarding/pre-onboarding" class="<%= panelLinkClass('/onboarding/pre-onboarding') %>">Pre-Onboarding</a>
              <a href="/onboarding/onboarding" class="<%= panelLinkClass('/onboarding/onboarding') %>">Onboarding</a>
              <a href="/onboarding/offboarding" class="<%= panelLinkClass('/onboarding/offboarding') %>">Offboarding</a>
              <a href="/recruitment" class="<%= panelLinkClass('/recruitment') %>">Recruitment</a>
            <% } %>
            <a href="/referrals" class="<%= panelLinkClass('/referrals') %>">Referrals</a>
            <% if (isManagerUp) { %>
              <a href="/succession" class="<%= panelLinkClass('/succession') %>">Succession Planning</a>
              <a href="/training/enrollments" class="<%= panelLinkClass('/training/enrollments') %>">Training Enrollments</a>
            <% } %>
            <% if (isHRTeamUser) { %>
              <a href="/benefits" class="<%= panelLinkClass('/benefits') %>">Benefits Enrollment</a>
              <a href="/letters" class="<%= panelLinkClass('/letters') %>">Letters</a>
              <a href="/system-policies" class="<%= panelLinkClass('/system-policies') %>">System Policies</a>
            <% } %>
            <% if (isAdminTeamUser) { %>
              <a href="/onboarding/admin-onboarding" class="<%= panelLinkClass('/onboarding/admin-onboarding') %>">Admin Onboarding</a>
              <a href="/onboarding/admin-offboarding" class="<%= panelLinkClass('/onboarding/admin-offboarding') %>">Admin Offboarding</a>
            <% } %>
          </div>
        </details>

        <details class="nav-dropdown">
          <summary class="<%= topTabClassAny(IT_PATHS) %>"><%- icon('monitor') %> IT Hub<span class="chev"><%- icon('chevron-down', {size:13}) %></span></summary>
          <div class="nav-dropdown-panel nav-dropdown-panel-wide">
            <a href="/it" class="panel-link hub-link">Hub Overview</a>
            <a href="/access-requests/mine" class="<%= panelLinkClass('/access-requests/mine') %>">My Access Requests</a>
            <a href="/vendors" class="<%= panelLinkClass('/vendors') %>">Vendors</a>
            <a href="/purchases" class="<%= panelLinkClass('/purchases') %>">Purchase Register</a>
            <a href="/stock" class="<%= panelLinkClass('/stock') %>">Stock / Inventory</a>
            <a href="/licenses" class="<%= panelLinkClass('/licenses') %>">Software Licenses</a>
            <a href="/rooms/bookings" class="<%= panelLinkClass('/rooms/bookings') %>">Room / Equipment Booking</a>
            <a href="/complaints/mine" class="<%= panelLinkClass('/complaints/mine') %>">My Complaints</a>
            <a href="/expenses/mine" class="<%= panelLinkClass('/expenses/mine') %>">My Expense Claims</a>
            <a href="/maintenance" class="<%= panelLinkClass('/maintenance') %>">Maintenance Announcements</a>
            <% if (isManagerUp) { %>
              <a href="/complaints" class="<%= panelLinkClass('/complaints') %>">All Complaints</a>
              <a href="/expenses" class="<%= panelLinkClass('/expenses') %>">All Expense Claims</a>
            <% } %>
            <% if (isITTeamUser) { %>
              <a href="/helpdesk" class="<%= panelLinkClass('/helpdesk') %>">IT Helpdesk</a>
              <a href="/asset-allocation" class="<%= panelLinkClass('/asset-allocation') %>">Asset Allocation</a>
              <a href="/it-clearance" class="<%= panelLinkClass('/it-clearance') %>">IT Clearance</a>
              <a href="/access-requests" class="<%= panelLinkClass('/access-requests') %>">Access Requests (All)</a>
              <a href="/vendor-service" class="<%= panelLinkClass('/vendor-service') %>">Vendor Service Tracking</a>
            <% } %>
            <% if (isITTeamUser || isAdminTeamUser) { %>
              <a href="/requirements" class="<%= panelLinkClass('/requirements') %>">Requirement Requests</a>
            <% } %>
          </div>
        </details>

        <details class="nav-dropdown">
          <summary class="<%= topTabClassAny(OPS_PATHS) %>"><%- icon('factory') %> Operations Hub<span class="chev"><%- icon('chevron-down', {size:13}) %></span></summary>
          <div class="nav-dropdown-panel nav-dropdown-panel-wide">
            <a href="/operations" class="panel-link hub-link">Hub Overview</a>
            <div class="panel-group">
              <div class="nav-dropdown-subsection-label">Safety</div>
              <a href="/safety/mine" class="<%= panelLinkClass('/safety/mine') %>">My Safety Reports</a>
              <% if (isManagerUp) { %><a href="/safety" class="<%= panelLinkClass('/safety') %>">All Safety Incidents</a><% } %>
            </div>
            <div class="panel-group">
              <div class="nav-dropdown-subsection-label">Sales, Production &amp; Logistics</div>
              <a href="/sales" class="<%= panelLinkClass('/sales') %>">Sales Orders</a>
              <a href="/work-orders" class="<%= panelLinkClass('/work-orders') %>">Work Orders</a>
              <a href="/engineering-changes" class="<%= panelLinkClass('/engineering-changes') %>">Engineering Change Requests</a>
              <a href="/shipments" class="<%= panelLinkClass('/shipments') %>">Shipments</a>
              <a href="/material-requests" class="<%= panelLinkClass('/material-requests') %>">Material Requests</a>
            </div>
            <div class="panel-group">
              <div class="nav-dropdown-subsection-label">Wellness &amp; Engagement</div>
              <a href="/wellness/programs" class="<%= panelLinkClass('/wellness/programs') %>">Wellness Programs</a>
              <a href="/wellness/pulse" class="<%= panelLinkClass('/wellness/pulse') %>">Pulse Survey</a>
              <a href="/wellness/kudos" class="<%= panelLinkClass('/wellness/kudos') %>">Kudos Wall</a>
              <% if (isManagerUp) { %><a href="/wellness/pulse/results" class="<%= panelLinkClass('/wellness/pulse/results') %>">Pulse Results</a><% } %>
            </div>
          </div>
        </details>

        <% if (currentUser.role === 'Administrator') { %>
        <details class="nav-dropdown nav-dropdown-right">
          <summary class="<%= topTabClassAny(ADMIN_PATHS) %>"><%- icon('settings') %> Admin Console<span class="chev"><%- icon('chevron-down', {size:13}) %></span></summary>
          <div class="nav-dropdown-panel">
            <a href="/admin" class="panel-link hub-link">Hub Overview</a>
            <a href="/admin/users" class="<%= panelLinkClass('/admin/users') %>">Users</a>
            <a href="/admin/permissions" class="<%= panelLinkClass('/admin/permissions') %>">Permissions</a>
            <a href="/admin/integrations" class="<%= panelLinkClass('/admin/integrations') %>">Integration Settings</a>
            <a href="/masterdata/departments" class="<%= panelLinkClass('/masterdata') %>">Master Data</a>
            <a href="/rooms/bookings" class="<%= panelLinkClass('/rooms/bookings') %>"><%- icon('calendar', {size:15}) %> Room Bookings</a>
          </div>
        </details>
        <% } %>

        <div class="top-tabs-spacer"></div>
        <form method="get" action="/search" class="top-tabs-search">
          <input type="text" name="q" placeholder="Search everything…" />
        </form>
        <div class="top-tabs-user">
          <span class="user-chip">
            <span class="avatar"><%= initials(currentUser.name) %></span>
            <span class="user-chip-text">
              <span class="user-chip-name"><%= currentUser.name %></span>
              <span class="role-badge"><%= currentUser.role %></span>
            </span>
          </span>
          <form method="post" action="/logout"><button class="link-button" title="Sign out"><%- icon('log-out', {size:15}) %></button></form>
        </div>
      </nav>
    <% } %>
    <main class="content">
      <% if (typeof departmentList !== "undefined" && departmentList.length) { %>
        <datalist id="departmentList">
          <% departmentList.forEach(function(d) { %><option value="<%= d %>"><% }) %>
        </datalist>
      <% } %>
      <% if (typeof employeeList !== "undefined" && employeeList.length) { %>
        <datalist id="employeeList">
          <% employeeList.forEach(function(e) { %><option value="<%= e %>"><% }) %>
        </datalist>
      <% } %>
      <% if (typeof locationList !== "undefined" && locationList.length) { %>
        <datalist id="locationList">
          <% locationList.forEach(function(l) { %><option value="<%= l %>"><% }) %>
        </datalist>
      <% } %>
      <% if (typeof assetNameList !== "undefined" && assetNameList.length) { %>
        <datalist id="assetNameList">
          <% assetNameList.forEach(function(a) { %><option value="<%= a %>"><% }) %>
        </datalist>
      <% } %>
