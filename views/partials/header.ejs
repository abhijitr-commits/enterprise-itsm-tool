<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title + " · Peppermint Robotics" : "Peppermint Robotics" %></title>
  <link rel="icon" href="/images/logo-mark.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" />
</head>
<body>
  <%
    // currentPath comes from src/middleware/auth.js's attachUser (set on
    // every request, res.locals.currentPath = req.path) — used to light
    // up the Dashboard link and to decide whether the Back/Home subnav
    // shows (it's hidden on the Dashboard itself, which already IS home).
    const cp = typeof currentPath !== "undefined" ? currentPath : "";
    const initials = (name) => String(name || "?").trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
  %>
  <div class="brand-watermark" aria-hidden="true">
    <img src="/images/logo-mark.png" alt="" />
    <span>Peppermint Robotics</span>
  </div>
  <div class="page-shell">
    <% if (currentUser) { %>
      <!-- Every module now has its own tile on the Dashboard (see
           views/dashboard.ejs: HR Hub, IT Hub, Operations Hub, Wellness,
           ITSM, Admin Console/Admin Operations) plus each hub page's own
           tile grid one level in — so the top bar doesn't need to repeat
           the same menu a second time. It just gets you Home, lets you
           search, and shows who's signed in. -->
      <nav class="top-tabs">
        <a class="brand-inline" href="/">
          <img class="brand-mark" src="/images/logo-mark.png" alt="Peppermint Robotics" />
          <span class="brand-inline-text">Peppermint Robotics</span>
        </a>
        <a class="<%= cp === '/' ? 'top-tab active' : 'top-tab' %>" href="/"><%- icon('home') %> Dashboard</a>
        <div class="top-tabs-utility">
          <form method="get" action="/search" class="top-tabs-search">
            <input type="text" name="q" placeholder="Search everything…" />
          </form>
          <a class="bell-link" href="/notifications" title="Notifications">
            <%- icon('bell', {size:18}) %>
            <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
              <span class="bell-badge"><%= unreadNotifications > 9 ? '9+' : unreadNotifications %></span>
            <% } %>
          </a>
          <div class="top-tabs-user">
            <span class="user-chip">
              <span class="avatar"><%= initials(currentUser.name) %></span>
              <span class="user-chip-text">
                <span class="user-chip-name"><%= currentUser.name %></span>
                <span class="role-badge"><%= currentUser.role %></span>
              </span>
            </span>
            <form method="post" action="/logout">
              <button class="link-button" title="Sign out">
                <%- icon('log-out', {size:15}) %><span class="logout-label">Sign out</span>
              </button>
            </form>
          </div>
        </div>
      </nav>
      <% if (cp !== '/') { %>
        <!-- Slim Back/Home bar on every page except the dashboard itself
             (which already IS home) — module pages have no other way to
             get back to the previous screen besides a browser back button
             the nav dropdowns don't set up history for. history.back() is
             the best signal we have of "where the user actually came
             from" without tracking a server-side page stack; falling back
             to Home covers a page opened fresh (e.g. a bookmark or a new
             tab) where there's no in-app history to go back to. -->
        <div class="subnav-bar">
          <button type="button" class="subnav-back" onclick="window.history.length > 1 ? window.history.back() : (window.location.href = '/')">
            <%- icon('arrow-left', {size:14}) %> Back
          </button>
          <a href="/" class="subnav-home"><%- icon('home', {size:14}) %> Home</a>
        </div>
      <% } %>
    <% } %>
    <main class="content">
      <% if (typeof departmentList !== "undefined" && departmentList.length) { %>
        <datalist id="departmentList">
          <% departmentList.forEach(function(d) { %><option value="<%= d %>"><% }) %>
        </datalist>
      <% } %>
      <% if (typeof employeeList !== "undefined" && employeeList.length) { %>
        <datalist id="employeeList">
          <% employeeList.forEach(function(e) { %><option value="<%= e %>"><% }) %>
        </datalist>
      <% } %>
      <% if (typeof locationList !== "undefined" && locationList.length) { %>
        <datalist id="locationList">
          <% locationList.forEach(function(l) { %><option value="<%= l %>"><% }) %>
        </datalist>
      <% } %>
      <% if (typeof assetNameList !== "undefined" && assetNameList.length) { %>
        <datalist id="assetNameList">
          <% assetNameList.forEach(function(a) { %><option value="<%= a %>"><% }) %>
        </datalist>
      <% } %>
