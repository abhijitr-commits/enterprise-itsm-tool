<!doctype html>
<html><head><meta charset="utf-8"><title>Error</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="centered-page">
  <div class="login-card" style="text-align:center">
    <h1>Something went wrong</h1>
    <p class="subtitle"><%= typeof message !== "undefined" && message ? message : "An unexpected error occurred. Please try again, and contact your Administrator if it keeps happening." %></p>
    <a class="btn btn-primary" href="/">Back to Dashboard</a>
  </div>
</body></html>
