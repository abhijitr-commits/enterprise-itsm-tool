<%- include('../partials/header', { title: 'Letter Templates' }) %>

<div class="page-header">
  <h1>Letter Templates</h1>
  <a class="btn btn-secondary" href="/letters">All Generated Letters</a>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="alert alert-info">
  Use <code>{{EmployeeName}}</code>, <code>{{EmployeeId}}</code>, <code>{{Department}}</code>,
  <code>{{Designation}}</code>, <code>{{JoiningDate}}</code>, <code>{{TodayDate}}</code>. The
  Relieving and Experience Letters also have <code>{{LastWorkingDay}}</code> and
  <code>{{Tenure}}</code> (a computed "X years Y months" between Date of Joining and Last
  Working Day). The No Dues Certificate also has <code>{{LastWorkingDay}}</code> /
  <code>{{ITClearance}}</code> / <code>{{FinanceClearance}}</code> / <code>{{HRClearance}}</code> /
  <code>{{ManagerClearance}}</code> / <code>{{AdminClearance}}</code>. Unknown placeholders are
  left as-is rather than silently disappearing. The Ref number and Date printed on the letter
  itself come from the generated record, not from a template placeholder — no need to add them
  here.
</div>

<form class="panel form-panel" method="post" action="/letters/templates">
  <label>Offer Letter Template
    <textarea name="offerLetter" rows="10"><%= offerLetter %></textarea>
  </label>
  <label>Appointment Letter Template
    <textarea name="appointmentLetter" rows="10"><%= appointmentLetter %></textarea>
  </label>
  <label>No Dues Certificate Template
    <textarea name="noDuesCertificate" rows="10"><%= noDuesCertificate %></textarea>
  </label>
  <label>Relieving Letter Template
    <textarea name="relievingLetter" rows="10"><%= relievingLetter %></textarea>
  </label>
  <label>Experience Letter Template
    <textarea name="experienceLetter" rows="10"><%= experienceLetter %></textarea>
  </label>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save Templates</button>
  </div>
</form>

<%- include('../partials/footer') %>
