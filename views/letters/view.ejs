<%- include('../partials/header', { title: letter.type + ' — ' + letter.recipientName }) %>

<style>
  .letter-page {
    max-width: 780px;
    margin: 24px auto;
    background: #fff;
    border: 1px solid #e2e2e2;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
  }
  .letterhead {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 28px 44px 18px;
    border-bottom: 3px solid var(--primary, #4f46e5);
  }
  .letterhead img { height: 46px; width: auto; }
  .letterhead .company-name { font-size: 20px; font-weight: 700; letter-spacing: 0.3px; color: #1a1a1a; }
  .letterhead .company-tagline { font-size: 12px; color: #666; margin-top: 2px; }
  .letter-meta {
    display: flex;
    justify-content: space-between;
    padding: 14px 44px 0;
    font-size: 13px;
    color: #444;
  }
  .letter-type-heading {
    text-align: center;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #1a1a1a;
    margin: 18px 44px 0;
    padding-bottom: 12px;
    border-bottom: 1px solid #e2e2e2;
  }
  .letter-body {
    padding: 22px 44px 48px;
    white-space: pre-wrap;
    line-height: 1.7;
    font-size: 14.5px;
    color: #1f1f1f;
  }
  @media print {
    .sidebar, .page-header, .no-print { display: none !important; }
    .app-shell { display: block !important; }
    .letter-page { border: none; box-shadow: none; margin: 0 auto; }
  }
</style>

<div class="page-header no-print">
  <h1><%= letter.type %></h1>
  <button class="btn btn-primary" onclick="window.print()">Print / Save as PDF</button>
</div>

<div class="hint no-print">Letter ID: <%= letter.letterId %> · Generated <%= new Date(letter.generatedDate).toLocaleDateString() %></div>

<div class="letter-page">
  <div class="letterhead">
    <img src="/images/logo-mark.png" alt="Peppermint Robotics" />
    <div>
      <div class="company-name">Peppermint Robotics</div>
      <div class="company-tagline">Human Resources Department</div>
    </div>
  </div>
  <div class="letter-meta">
    <span>Ref: <%= letter.letterId %></span>
    <span>Date: <%= new Date(letter.generatedDate).toLocaleDateString() %></span>
  </div>
  <div class="letter-type-heading"><%= letter.type %></div>
  <div class="letter-body"><%= letter.content %></div>
</div>

<%- include('../partials/footer') %>
