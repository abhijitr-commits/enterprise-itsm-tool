<%- include('../partials/header', { title: 'Generate Experience Letter' }) %>

<div class="page-header">
  <h1>Generate an Experience Letter</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<% if (employees && employees.length) { %>
  <div class="alert alert-success">The template is already filled in — pick an employee below and every field auto-fills, ready to generate.</div>
<% } %>

<form class="panel form-panel" method="post" action="/letters/experience" id="experience-letter-form">
  <input type="hidden" name="employeeId" id="experience-employeeId" value="<%= form.employeeId || '' %>" />
  <div class="form-grid">
    <label>Employee
      <select id="experience-employee-select">
        <option value="">— Select an employee —</option>
        <% (employees || []).forEach(function(e) { %>
          <option
            value="<%= e.name %>"
            data-id="<%= e.employeeId %>"
            data-department="<%= e.department || '' %>"
            data-designation="<%= e.designation || '' %>"
            data-joining="<%= (e.dateOfJoining || e.createdDate) ? new Date(e.dateOfJoining || e.createdDate).toISOString().slice(0,10) : '' %>"
          ><%= e.name %> <% if (e.department) { %>— <%= e.department %><% } %></option>
        <% }) %>
        <option value="__other__">Other (type a name manually)…</option>
      </select>
    </label>
    <label id="experience-employeeName-label" style="display:none">Employee Name
      <input type="text" id="experience-employeeName-manual" value="<%= form.employeeName || '' %>" />
    </label>
    <label>Department
      <input type="text" name="department" list="departmentList" id="experience-department" value="<%= form.department || '' %>" />
    </label>
    <label>Designation
      <input type="text" name="designation" id="experience-designation" value="<%= form.designation || '' %>" />
    </label>
    <label>Date of Joining
      <input type="date" name="joiningDate" id="experience-joiningDate" value="<%= form.joiningDate || '' %>" required />
    </label>
    <label>Last Working Day
      <input type="date" name="lastWorkingDay" value="<%= form.lastWorkingDay || '' %>" required />
    </label>
  </div>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/letters">Cancel</a>
    <button type="submit" class="btn btn-primary">Generate Experience Letter</button>
  </div>
</form>

<script>
  (function () {
    var select = document.getElementById('experience-employee-select');
    var nameLabel = document.getElementById('experience-employeeName-label');
    var nameManual = document.getElementById('experience-employeeName-manual');
    var department = document.getElementById('experience-department');
    var designation = document.getElementById('experience-designation');
    var joiningDate = document.getElementById('experience-joiningDate');
    var employeeId = document.getElementById('experience-employeeId');
    var form = document.getElementById('experience-letter-form');

    select.addEventListener('change', function () {
      var opt = select.options[select.selectedIndex];
      if (select.value === '__other__') {
        nameLabel.style.display = '';
        nameManual.focus();
        employeeId.value = '';
      } else {
        nameLabel.style.display = 'none';
        employeeId.value = (opt && opt.getAttribute('data-id')) || '';
        department.value = (opt && opt.getAttribute('data-department')) || '';
        designation.value = (opt && opt.getAttribute('data-designation')) || '';
        joiningDate.value = (opt && opt.getAttribute('data-joining')) || '';
      }
    });

    form.addEventListener('submit', function (evt) {
      var name = select.value === '__other__' ? nameManual.value.trim() : select.value;
      if (!name) {
        evt.preventDefault();
        alert('Please select an employee, or choose "Other" and type a name.');
        return;
      }
      var hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'employeeName';
      hidden.value = name;
      form.appendChild(hidden);
    });
  })();
</script>

<%- include('../partials/footer') %>
