<%- include('../partials/header', { title: 'Letters' }) %>

<div class="page-header">
  <h1>Generated Letters</h1>
  <div>
    <a class="btn btn-secondary" href="/letters/offer/new">+ Offer Letter</a>
    <a class="btn btn-secondary" href="/letters/appointment/new">+ Appointment Letter</a>
    <a class="btn btn-secondary" href="/letters/relieving/new">+ Relieving Letter</a>
    <a class="btn btn-secondary" href="/letters/templates">Edit Templates</a>
  </div>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>ID</th><th>Type</th><th>Recipient</th><th>Generated</th><th></th></tr></thead>
    <tbody>
      <% letters.forEach(function(l) { %>
        <tr>
          <td><%= l.letterId %></td>
          <td><%= l.type %></td>
          <td><%= l.recipientName %></td>
          <td><%= new Date(l.generatedDate).toLocaleDateString() %></td>
          <td><a class="btn btn-secondary" href="/letters/<%= l.letterId %>">View / Print</a></td>
        </tr>
      <% }) %>
      <% if (letters.length === 0) { %><tr><td colspan="5" class="empty-row">No letters generated yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
