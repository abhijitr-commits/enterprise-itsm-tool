<%- include('../partials/header', { title: 'Generate Offer Letter' }) %>

<div class="page-header">
  <h1>Generate an Offer Letter</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="alert alert-info">
  There's no email provider connected yet (see MIGRATION.md), so this
  doesn't email the candidate — it generates a printable letter you can
  download/print and send yourself. It still checks off "Offer Letter
  Sent" on the candidate's Pre-Onboarding checklist.
</div>

<form class="panel form-panel" method="post" action="/letters/offer">
  <input type="hidden" name="candidateId" value="<%= form.candidateId || '' %>" />
  <div class="form-grid">
    <label>Candidate Name
      <input type="text" name="candidateName" value="<%= form.candidateName || '' %>" required />
    </label>
    <label>Candidate Email
      <input type="email" name="candidateEmail" value="<%= form.candidateEmail || '' %>" required />
    </label>
    <label>Department
      <input type="text" name="department" value="<%= form.department || '' %>" />
    </label>
    <label>Designation
      <input type="text" name="designation" value="<%= form.designation || '' %>" />
    </label>
    <label>Joining Date
      <input type="date" name="joiningDate" value="<%= form.joiningDate || '' %>" />
    </label>
  </div>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/letters">Cancel</a>
    <button type="submit" class="btn btn-primary">Generate Offer Letter</button>
  </div>
</form>

<%- include('../partials/footer') %>
