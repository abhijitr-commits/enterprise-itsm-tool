<%- include('../partials/header', { title: 'Generate Relieving Letter' }) %>

<div class="page-header">
  <h1>Generate a Relieving Letter</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<% if (employees && employees.length) { %>
  <div class="alert alert-success">The template is already filled in — pick an employee below and every field auto-fills, ready to generate.</div>
<% } %>

<form class="panel form-panel" method="post" action="/letters/relieving" id="relieving-letter-form">
  <input type="hidden" name="employeeId" id="relieving-employeeId" value="<%= form.employeeId || '' %>" />
  <div class="form-grid">
    <label>Employee
      <select id="relieving-employee-select">
        <option value="">— Select an employee —</option>
        <% (employees || []).forEach(function(e) { %>
          <option
            value="<%= e.name %>"
            data-id="<%= e.employeeId %>"
            data-department="<%= e.department || '' %>"
            data-designation="<%= e.designation || '' %>"
          ><%= e.name %> <% if (e.department) { %>— <%= e.department %><% } %></option>
        <% }) %>
        <option value="__other__">Other (type a name manually)…</option>
      </select>
    </label>
    <label id="relieving-employeeName-label" style="display:none">Employee Name
      <input type="text" id="relieving-employeeName-manual" value="<%= form.employeeName || '' %>" />
    </label>
    <label>Department
      <input type="text" name="department" list="departmentList" id="relieving-department" value="<%= form.department || '' %>" />
    </label>
    <label>Designation
      <input type="text" name="designation" id="relieving-designation" value="<%= form.designation || '' %>" />
    </label>
    <label>Last Working Day
      <input type="date" name="lastWorkingDay" value="<%= form.lastWorkingDay || '' %>" required />
    </label>
  </div>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/letters">Cancel</a>
    <button type="submit" class="btn btn-primary">Generate Relieving Letter</button>
  </div>
</form>

<script>
  (function () {
    var select = document.getElementById('relieving-employee-select');
    var nameLabel = document.getElementById('relieving-employeeName-label');
    var nameManual = document.getElementById('relieving-employeeName-manual');
    var department = document.getElementById('relieving-department');
    var designation = document.getElementById('relieving-designation');
    var employeeId = document.getElementById('relieving-employeeId');
    var form = document.getElementById('relieving-letter-form');

    select.addEventListener('change', function () {
      var opt = select.options[select.selectedIndex];
      if (select.value === '__other__') {
        nameLabel.style.display = '';
        nameManual.focus();
        employeeId.value = '';
      } else {
        nameLabel.style.display = 'none';
        employeeId.value = (opt && opt.getAttribute('data-id')) || '';
        department.value = (opt && opt.getAttribute('data-department')) || '';
        designation.value = (opt && opt.getAttribute('data-designation')) || '';
      }
    });

    form.addEventListener('submit', function (evt) {
      var name = select.value === '__other__' ? nameManual.value.trim() : select.value;
      if (!name) {
        evt.preventDefault();
        alert('Please select an employee, or choose "Other" and type a name.');
        return;
      }
      var hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'employeeName';
      hidden.value = name;
      form.appendChild(hidden);
    });
  })();
</script>

<%- include('../partials/footer') %>
