<%- include('../partials/header', { title: 'Problems' }) %>

<div class="page-header">
  <h1>Problem Register</h1>
  <a class="btn btn-primary" href="/problems/new">+ New Problem</a>
</div>

<form class="filter-bar" method="get" action="/problems">
  <input type="text" name="q" placeholder="Search problems…" value="<%= query.q %>" />
  <select name="status">
    <option value="">All statuses</option>
    <% Object.values(STATUS).forEach(function(s){ %>
      <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
</form>

<div class="panel">
  <table class="table">
    <thead>
      <tr><th>ID</th><th>Title</th><th>Known Error</th><th>Status</th><th>Owner</th><th>Linked Incidents</th></tr>
    </thead>
    <tbody>
      <% problems.forEach(function(p) { %>
        <tr onclick="location.href='/problems/<%= p._id %>'">
          <td><%= p.problemId %></td>
          <td><%= p.title %></td>
          <td><%= p.knownError %></td>
          <td><span class="badge badge-status-<%= p.status.toLowerCase().replace(/ /g,'-') %>"><%= p.status %></span></td>
          <td><%= p.owner || '—' %></td>
          <td><%= p.linkedIncidents || '—' %></td>
        </tr>
      <% }) %>
      <% if (problems.length === 0) { %>
        <tr><td colspan="6" class="empty-row">No problems match your filters.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
