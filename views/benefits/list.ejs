<%- include('../partials/header', { title: 'Benefits Enrollment' }) %>

<div class="page-header">
  <h1>Benefits Enrollment</h1>
  <a class="btn btn-primary" href="/benefits/new">+ Enroll Employee</a>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>ID</th><th>Employee</th><th>Benefit Type</th><th>Plan</th><th>Coverage</th><th>Enrolled</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% enrollments.forEach(function(b) { %>
        <tr>
          <td><%= b.enrollmentId %></td>
          <td><%= b.employee %></td>
          <td><%= b.benefitType %></td>
          <td><%= b.planName %></td>
          <td><%= b.coverageDetails || '—' %></td>
          <td><%= new Date(b.enrollmentDate).toLocaleDateString() %></td>
          <td><span class="badge <%= b.status === 'Active' ? 'badge-status-open' : 'badge-status-closed' %>"><%= b.status %></span></td>
          <td>
            <form method="post" action="/benefits/<%= b._id %>/status" class="filter-bar">
              <select name="status">
                <option value="Active" <%= b.status === 'Active' ? 'selected' : '' %>>Active</option>
                <option value="Inactive" <%= b.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
              </select>
              <button type="submit" class="btn btn-secondary">Update</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (enrollments.length === 0) { %><tr><td colspan="8" class="empty-row">No benefit enrollments yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
