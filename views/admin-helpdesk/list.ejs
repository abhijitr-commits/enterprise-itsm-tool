<%- include('../partials/header', { title: 'Admin Facility Helpdesk' }) %>

<div class="page-header">
  <h1>Admin Facility Helpdesk</h1>
  <div class="header-actions">
    <a class="btn btn-secondary" href="/admin/ops">← Admin Ops Hub</a>
    <a class="btn btn-primary" href="/admin/helpdesk/new">+ Raise Request</a>
  </div>
</div>

<%- include('../partials/csvActions', { moduleKey: 'adminComplaint' }) %>

<p class="hint">Facility &amp; office-services requests — housekeeping, pantry, seating, AC, courier — separate from the general Complaints module. Anyone can raise one; the Admin team triages and resolves.</p>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <div class="table-scroll">
  <table class="table">
    <thead><tr><th>Complaint ID</th><th>Complainant</th><th>Department</th><th>Category</th><th>Subject</th><th>Status</th><th>Assigned To</th><% if (canManage) { %><th></th><% } %><th></th></tr></thead>
    <tbody>
      <% complaints.forEach(function(c) { %>
        <tr>
          <td><%= c.complaintId %></td>
          <td><%= c.complainant %></td>
          <td><%= c.department || '—' %></td>
          <td><%= c.category %></td>
          <td><%= c.subject %></td>
          <td><span class="badge <%= c.status === 'Open' ? 'badge-status-open' : (c.status === 'Resolved' || c.status === 'Closed' ? 'badge-status-resolved' : 'badge-status-in-progress') %>"><%= c.status %></span></td>
          <td><%= c.assignedTo || '—' %></td>
          <% if (canManage) { %>
            <td>
              <form method="post" action="/admin/helpdesk/<%= c.complaintId %>/status" class="filter-bar">
                <select name="status">
                  <% Object.values(ADMIN_COMPLAINT_STATUS).forEach(function(s) { %>
                    <option value="<%= s %>" <%= c.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
                <input type="text" name="assignedTo" list="assignableUsersList" placeholder="Assign to" value="<%= c.assignedTo || '' %>" style="width:110px;" />
                <button type="submit" class="btn btn-secondary">Update</button>
              </form>
            </td>
          <% } %>
          <td><a class="btn btn-secondary" href="/admin-attachments/admin-helpdesk/<%= c._id %>" title="Attachments"><%- icon('paperclip', {size:14}) %></a></td>
        </tr>
      <% }) %>
      <% if (complaints.length === 0) { %><tr><td colspan="<%= canManage ? 9 : 8 %>" class="empty-row">No facility requests yet.</td></tr><% } %>
    </tbody>
  </table>
  <%- include('../partials/pagination', { pageInfo }) %>
  </div>
</div>

<%- include('../partials/footer') %>
