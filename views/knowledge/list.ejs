<%- include('../partials/header', { title: 'Knowledge Base' }) %>

<div class="page-header">
  <h1>Knowledge Base</h1>
  <a class="btn btn-primary" href="/knowledge/new">+ New Article</a>
</div>

<form class="filter-bar" method="get" action="/knowledge">
  <input type="text" name="q" placeholder="Search articles…" value="<%= query.q %>" />
  <select name="status">
    <option value="">All statuses</option>
    <option value="Published" <%= query.status === 'Published' ? 'selected' : '' %>>Published</option>
    <option value="Draft" <%= query.status === 'Draft' ? 'selected' : '' %>>Draft</option>
    <option value="Archived" <%= query.status === 'Archived' ? 'selected' : '' %>>Archived</option>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
</form>

<div class="panel">
  <table class="table">
    <thead>
      <tr><th>ID</th><th>Title</th><th>Category</th><th>Author</th><th>Last Updated</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% articles.forEach(function(a) { %>
        <tr onclick="location.href='/knowledge/<%= a._id %>'">
          <td><%= a.articleId %></td>
          <td><%= a.title %></td>
          <td><%= a.category %></td>
          <td><%= a.author || '—' %></td>
          <td><%= new Date(a.lastUpdated).toLocaleString() %></td>
          <td><span class="badge badge-status-<%= a.status.toLowerCase() %>"><%= a.status %></span></td>
        </tr>
      <% }) %>
      <% if (articles.length === 0) { %>
        <tr><td colspan="6" class="empty-row">No articles match your filters.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
