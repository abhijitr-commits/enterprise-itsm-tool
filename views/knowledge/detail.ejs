<%- include('../partials/header', { title: article.articleId }) %>

<div class="page-header">
  <h1><%= article.articleId %> — <%= article.title %></h1>
</div>

<% if (justCreated) { %><div class="alert alert-success">Article published successfully.</div><% } %>

<div class="detail-grid">
  <form class="panel form-panel" method="post" action="/knowledge/<%= article._id %>">
    <div class="form-grid">
      <label>Category
        <input type="text" name="category" value="<%= article.category %>" />
      </label>
      <label>Status
        <select name="status">
          <option value="Published" <%= article.status === 'Published' ? 'selected' : '' %>>Published</option>
          <option value="Draft" <%= article.status === 'Draft' ? 'selected' : '' %>>Draft</option>
          <option value="Archived" <%= article.status === 'Archived' ? 'selected' : '' %>>Archived</option>
        </select>
      </label>
    </div>
    <label>Title
      <input type="text" name="title" value="<%= article.title %>" required />
    </label>
    <label>Content
      <textarea name="content" rows="12" required><%= article.content %></textarea>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save (creates a new version)</button>
    </div>
  </form>

  <div class="panel">
    <div class="panel-header"><h2>Details</h2></div>
    <dl class="meta-list">
      <dt>Author</dt><dd><%= article.author || '—' %></dd>
      <dt>Last Updated</dt><dd><%= new Date(article.lastUpdated).toLocaleString() %></dd>
      <dt>Created</dt><dd><%= new Date(article.createdDate).toLocaleString() %></dd>
      <dt>Version</dt><dd><%= history.length + 1 %></dd>
    </dl>

    <div class="panel-header"><h2>Version History</h2></div>
    <div class="comment-list">
      <% history.forEach(function(v) { %>
        <div class="comment">
          <div class="comment-meta">v<%= v.version %> · <%= new Date(v.versionDate).toLocaleString() %> · <%= v.author || '—' %></div>
          <div class="comment-text"><strong><%= v.title %></strong> (<%= v.category %>)</div>
        </div>
      <% }) %>
      <% if (history.length === 0) { %><p class="empty-row">No prior versions yet.</p><% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
