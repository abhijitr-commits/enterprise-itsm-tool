<%- include('../partials/header', { title: 'Training Catalog' }) %>

<div class="page-header">
  <h1>Training Catalog</h1>
  <% if (currentUser.role === 'Administrator' || currentUser.role === 'Manager') { %>
    <a class="btn btn-primary" href="/training/courses/new">+ Add Course</a>
  <% } %>
</div>

<%- include('../partials/csvActions', { moduleKey: 'course' }) %>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>ID</th><th>Title</th><th>Type</th><th>Category</th><th>Duration</th><th>Provider</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% courses.forEach(function(c) { %>
        <tr>
          <td><%= c.courseId %></td>
          <td><%= c.title %><% if (c.description) { %><div class="hint"><%= c.description %></div><% } %>
            <% if (c.linkOrLocation) { %><div class="hint"><%= c.linkOrLocation %></div><% } %>
          </td>
          <td><%= c.type %></td>
          <td><%= c.category %></td>
          <td><%= c.durationHours ? c.durationHours + 'h' : '—' %></td>
          <td><%= c.provider || '—' %></td>
          <td><span class="badge <%= c.status === 'Active' ? 'badge-status-open' : 'badge-status-closed' %>"><%= c.status %></span></td>
          <td><a class="btn btn-secondary" href="/admin-attachments/courses/<%= c._id %>" title="Attachments"><%- icon('paperclip', {size:14}) %></a></td>
        </tr>
      <% }) %>
      <% if (courses.length === 0) { %><tr><td colspan="8" class="empty-row">No courses in the catalog yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
