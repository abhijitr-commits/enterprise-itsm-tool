<%- include('../partials/header', { title: 'Maintenance Announcements' }) %>

<div class="page-header">
  <h1>Maintenance Announcements</h1>
  <div class="header-actions">
    <a class="btn btn-secondary" href="/it">← IT Hub</a>
    <a class="btn btn-secondary" href="/operations">← Operations Hub</a>
    <a class="btn btn-primary" href="/maintenance/new">+ New Announcement</a>
  </div>
</div>

<%- include('../partials/csvActions', { moduleKey: 'maintenanceAnnouncement' }) %>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>Title</th><th>Description</th><th>Site/Location</th><th>Scheduled</th><th>Created By</th><th>Posted</th><th></th></tr></thead>
    <tbody>
      <% announcements.forEach(function(a) { %>
        <tr>
          <td><%= a.title %></td>
          <td><%= a.description %></td>
          <td><%= a.site %></td>
          <td>
            <%= a.scheduledStart ? new Date(a.scheduledStart).toLocaleString() : 'TBD' %>
            to
            <%= a.scheduledEnd ? new Date(a.scheduledEnd).toLocaleString() : 'TBD' %>
          </td>
          <td><%= a.createdBy %></td>
          <td><%= new Date(a.createdDate).toLocaleDateString() %></td>
          <td><a class="btn btn-secondary" href="/admin-attachments/maintenance/<%= a._id %>" title="Attachments"><%- icon('paperclip', {size:14}) %></a></td>
        </tr>
      <% }) %>
      <% if (announcements.length === 0) { %><tr><td colspan="7" class="empty-row">No maintenance announcements yet.</td></tr><% } %>
    </tbody>
  </table>
  <%- include('../partials/pagination', { pageInfo }) %>
</div>

<%- include('../partials/footer') %>
