<%- include('../partials/header', { title: 'CMDB' }) %>

<div class="page-header">
  <h1>Configuration Management Database</h1>
  <div class="header-actions">
    <a class="btn btn-secondary" href="/assets">← Assets</a>
    <a class="btn btn-primary" href="/cmdb/new">+ New CI</a>
  </div>
</div>

<form class="filter-bar" method="get" action="/cmdb">
  <input type="text" name="q" placeholder="Search CIs…" value="<%= query.q %>" />
  <select name="status">
    <option value="">All statuses</option>
    <option value="Active" <%= query.status === 'Active' ? 'selected' : '' %>>Active</option>
    <option value="Inactive" <%= query.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
    <option value="Decommissioned" <%= query.status === 'Decommissioned' ? 'selected' : '' %>>Decommissioned</option>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
</form>

<div class="panel">
  <table class="table">
    <thead>
      <tr><th>CI ID</th><th>Name</th><th>Type</th><th>IP Address</th><th>Owner</th><th>Status</th><th>Dependencies</th></tr>
    </thead>
    <tbody>
      <% cis.forEach(function(ci) { %>
        <tr onclick="location.href='/cmdb/<%= ci._id %>'">
          <td><%= ci.ciId %></td>
          <td><%= ci.ciName %></td>
          <td><%= ci.type %></td>
          <td><%= ci.ipAddress || '—' %></td>
          <td><%= ci.owner || '—' %></td>
          <td><span class="badge badge-status-<%= ci.status.toLowerCase() %>"><%= ci.status %></span></td>
          <td><%= ci.dependencies || '—' %></td>
        </tr>
      <% }) %>
      <% if (cis.length === 0) { %>
        <tr><td colspan="7" class="empty-row">No configuration items match your filters.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
