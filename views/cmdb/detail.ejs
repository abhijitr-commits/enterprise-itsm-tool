<%- include('../partials/header', { title: ci.ciId }) %>

<div class="page-header">
  <h1><%= ci.ciId %> — <%= ci.ciName %></h1>
  <div class="header-actions">
    <a class="btn btn-secondary" href="/cmdb/<%= ci._id %>/impact"><%- icon('layers', {size:15}) %> Impact Analysis</a>
    <a class="btn btn-secondary" href="/cmdb/graph">🕸 Graph View</a>
    <form method="post" action="/cmdb/<%= ci._id %>/delete" onsubmit="return confirm('Delete this configuration item permanently?')">
      <button class="btn btn-danger" type="submit">Delete</button>
    </form>
  </div>
</div>

<% if (justCreated) { %><div class="alert alert-success">Configuration item created successfully.</div><% } %>

<form class="panel form-panel" method="post" action="/cmdb/<%= ci._id %>">
  <div class="form-grid">
    <label>CI Name
      <input type="text" name="ciName" value="<%= ci.ciName %>" required />
    </label>
    <label>Type
      <input type="text" name="type" value="<%= ci.type %>" required />
    </label>
    <label>IP Address
      <input type="text" name="ipAddress" value="<%= ci.ipAddress || '' %>" />
    </label>
    <label>Owner
      <input type="text" name="owner" value="<%= ci.owner || '' %>" />
    </label>
    <label>Status
      <select name="status">
        <option value="Active" <%= ci.status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= ci.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
        <option value="Decommissioned" <%= ci.status === 'Decommissioned' ? 'selected' : '' %>>Decommissioned</option>
      </select>
    </label>
    <label>VLAN
      <input type="text" name="vlan" value="<%= ci.vlan || '' %>" />
    </label>
    <label>Subnet
      <input type="text" name="subnet" value="<%= ci.subnet || '' %>" />
    </label>
  </div>
  <label>Dependencies
    <input type="text" name="dependencies" value="<%= ci.dependencies || '' %>" />
  </label>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </div>
</form>

<div class="panel" id="relationships">
  <div class="panel-header"><h2>Relationships</h2></div>
  <p class="hint" style="margin: -4px 0 14px;">
    Typed, directed links between CIs — used by Impact Analysis and the Graph View, on top of (not instead of) the
    free-text Dependencies field above.
  </p>

  <% if (relError) { %><div class="alert alert-error"><%= relError %></div><% } %>

  <form method="post" action="/cmdb/<%= ci._id %>/relationships" class="filter-bar" style="margin-bottom: 18px;">
    <span class="hint" style="align-self:center;"><%= ci.ciId %> —</span>
    <select name="type">
      <% relationshipTypes.forEach(function(t) { %>
        <option value="<%= t %>"><%= t %></option>
      <% }) %>
    </select>
    <span class="hint" style="align-self:center;">→</span>
    <select name="targetId" required>
      <option value="">Choose a CI…</option>
      <% otherCIs.forEach(function(c) { %>
        <option value="<%= c._id %>"><%= c.ciId %> — <%= c.ciName %></option>
      <% }) %>
    </select>
    <input type="text" name="notes" placeholder="Notes (optional)" style="flex: 1 1 160px;" />
    <button type="submit" class="btn btn-secondary">Add Relationship</button>
  </form>

  <div class="admin-tile-sub" style="font-weight:600; margin-bottom:6px;">Outgoing — <%= ci.ciId %> relates to…</div>
  <table class="table" style="margin-bottom:18px;">
    <thead><tr><th>Type</th><th>Target CI</th><th>Notes</th><th></th></tr></thead>
    <tbody>
      <% outgoing.forEach(function(r) { %>
        <tr>
          <td><%= r.type %></td>
          <td><% if (r.target) { %><a href="/cmdb/<%= r.target._id %>"><%= r.target.ciId %> — <%= r.target.ciName %></a><% } else { %><span class="empty-row">Deleted CI</span><% } %></td>
          <td><%= r.notes || '—' %></td>
          <td>
            <form method="post" action="/cmdb/relationships/<%= r._id %>/delete" onsubmit="return confirm('Remove this relationship?')">
              <input type="hidden" name="returnTo" value="<%= ci._id %>" />
              <button type="submit" class="btn btn-danger" style="padding: 2px 10px;">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (outgoing.length === 0) { %><tr><td colspan="4" class="empty-row">No outgoing relationships yet.</td></tr><% } %>
    </tbody>
  </table>

  <div class="admin-tile-sub" style="font-weight:600; margin-bottom:6px;">Incoming — these relate to <%= ci.ciId %></div>
  <table class="table">
    <thead><tr><th>Source CI</th><th>Type</th><th>Notes</th></tr></thead>
    <tbody>
      <% incoming.forEach(function(r) { %>
        <tr>
          <td><% if (r.source) { %><a href="/cmdb/<%= r.source._id %>"><%= r.source.ciId %> — <%= r.source.ciName %></a><% } else { %><span class="empty-row">Deleted CI</span><% } %></td>
          <td><%= r.type %></td>
          <td><%= r.notes || '—' %></td>
        </tr>
      <% }) %>
      <% if (incoming.length === 0) { %><tr><td colspan="3" class="empty-row">Nothing else in the CMDB points at <%= ci.ciId %> yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/attachments', { attachments, moduleKey, recordId: ci._id, canUpload }) %>
<%- include('../partials/auditTrail', { auditEntries }) %>

<%- include('../partials/footer') %>
