<%- include('../partials/header', { title: table.label + ' · Master Data' }) %>

<div class="page-header">
  <h1>Master Data</h1>
  <a class="btn btn-primary" href="/masterdata/<%= tableKey %>/new">+ Add <%= table.label.replace(/s$/, '') %></a>
</div>

<%
  // masterdata's own tableKey strings (plural: "departments", "slamatrix"...)
  // don't match utils/csvRegistry.js's model-derived moduleKeys — this is
  // the one place that needs a small alias, since this single view serves
  // 5 different models off one tableKey param.
  const CSV_MASTERDATA_KEY = { departments: 'department', locations: 'location', categories: 'category', slamatrix: 'slaMatrix', holidays: 'holiday' }[tableKey];
%>
<% if (CSV_MASTERDATA_KEY) { %>
<%- include('../partials/csvActions', { moduleKey: CSV_MASTERDATA_KEY }) %>
<% } %>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
<% if (typeof error !== "undefined" && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="tab-bar">
  <% tables.forEach(function(t) { %>
    <a class="tab <%= t.key === tableKey ? 'tab-active' : '' %>" href="/masterdata/<%= t.key %>"><%= t.label %></a>
  <% }) %>
</div>

<div class="panel">
  <table class="table">
    <thead>
      <tr>
        <% table.fields.forEach(function(f) { %><th><%= f.label %></th><% }) %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(row) { %>
        <tr>
          <% table.fields.forEach(function(f) { %>
            <%
              let cellValue = row[f.name];
              if (cellValue instanceof Date) cellValue = cellValue.toLocaleDateString();
            %>
            <td><%= (cellValue === undefined || cellValue === null || cellValue === '') ? '—' : cellValue %></td>
          <% }) %>
          <td>
            <a class="btn btn-secondary" href="/masterdata/<%= tableKey %>/<%= row._id %>/edit">Edit</a>
            <form method="post" action="/masterdata/<%= tableKey %>/<%= row._id %>/delete" style="display:inline">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %>
        <tr><td colspan="<%= table.fields.length + 1 %>" class="empty-row">No <%= table.label.toLowerCase() %> yet.</td></tr>
      <% } %>
    </tbody>
  </table>
  <%- include('../partials/pagination', { pageInfo }) %>
</div>

<%- include('../partials/footer') %>
