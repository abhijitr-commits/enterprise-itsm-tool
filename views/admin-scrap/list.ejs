<%- include('../partials/header', { title: 'Scrap Management' }) %>

<div class="page-header">
  <h1>Scrap Management</h1>
  <a class="btn btn-primary" href="/admin/scrap/new">+ Raise Scrap Entry</a>
</div>

<%- include('../partials/csvActions', { moduleKey: 'adminScrapItem' }) %>

<p class="hint">Damaged, expired, or obsolete items taken out of use — request, approve, then mark disposed. Disposing an entry linked to a Stock Management Item Code also records a real stock OUT for the scrapped quantity.</p>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <div class="table-scroll">
  <table class="table">
    <thead>
      <tr>
        <th>Scrap ID</th><th>Item Code</th><th>Item Name</th><th>Category</th><th>Quantity</th>
        <th>Reason</th><th>Scrap Date</th><th>Status</th><th>Disposal Method</th><th>Value Recovered</th>
        <th></th><th></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(s) { %>
        <tr>
          <td><%= s.scrapId %></td>
          <td><%= s.itemCode || '—' %></td>
          <td><%= s.itemName %></td>
          <td><%= s.category %></td>
          <td><%= s.quantity %> <%= s.unit %></td>
          <td><%= s.reason %></td>
          <td><%= s.scrapDate ? new Date(s.scrapDate).toLocaleDateString() : '—' %></td>
          <td>
            <span class="badge <%= s.status === 'Disposed' ? 'badge-status-resolved' : (s.status === 'Cancelled' ? 'badge-status-closed' : (s.status === 'Approved' ? 'badge-status-in-progress' : 'badge-status-on-hold')) %>"><%= s.status %></span>
          </td>
          <td><%= s.disposalMethod || '—' %></td>
          <td><%= s.status === 'Disposed' ? s.valueRecovered : '—' %></td>
          <td>
            <% if (s.status === 'Pending Approval') { %>
              <form method="post" action="/admin/scrap/<%= s.scrapId %>/approve" style="display:inline-block;">
                <button type="submit" class="btn btn-secondary">Approve</button>
              </form>
              <form method="post" action="/admin/scrap/<%= s.scrapId %>/cancel" style="display:inline-block;">
                <button type="submit" class="btn btn-secondary">Cancel</button>
              </form>
            <% } else if (s.status === 'Approved') { %>
              <details>
                <summary class="btn btn-secondary" style="display:inline-block; cursor:pointer;">Mark Disposed</summary>
                <form method="post" action="/admin/scrap/<%= s.scrapId %>/dispose" class="filter-bar" style="margin-top:8px; flex-wrap:wrap;">
                  <select name="disposalMethod" required>
                    <% Object.values(DISPOSAL_METHOD).forEach(function(d) { %><option value="<%= d %>"><%= d %></option><% }) %>
                  </select>
                  <input type="number" name="valueRecovered" min="0" step="0.01" placeholder="Value Recovered" style="width:130px;" />
                  <button type="submit" class="btn btn-primary">Confirm</button>
                </form>
              </details>
              <form method="post" action="/admin/scrap/<%= s.scrapId %>/cancel" style="display:inline-block;">
                <button type="submit" class="btn btn-secondary">Cancel</button>
              </form>
            <% } %>
          </td>
          <td><a class="btn btn-secondary" href="/admin-attachments/admin-scrap/<%= s._id %>" title="Attachments"><%- icon('paperclip', {size:14}) %></a></td>
        </tr>
      <% }) %>
      <% if (items.length === 0) { %><tr><td colspan="12" class="empty-row">No scrap entries yet.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>

<%- include('../partials/footer') %>
