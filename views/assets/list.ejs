<%- include('../partials/header', { title: 'Assets' }) %>

<div class="page-header">
  <h1>Asset Register</h1>
  <div class="header-actions">
    <a class="btn btn-secondary" href="/cmdb">CMDB →</a>
    <a class="btn btn-primary" href="/assets/new">+ New Asset</a>
  </div>
</div>

<form class="filter-bar" method="get" action="/assets">
  <input type="text" name="q" placeholder="Search assets…" value="<%= query.q %>" />
  <select name="status">
    <option value="">All statuses</option>
    <% Object.values(ASSET_STATUS).forEach(function(s){ %>
      <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
</form>

<div class="panel">
  <table class="table">
    <thead>
      <tr><th>ID</th><th>Name</th><th>Type</th><th>Serial No.</th><th>Assigned To</th><th>Department</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% assets.forEach(function(a) { %>
        <tr onclick="location.href='/assets/<%= a._id %>'">
          <td><%= a.assetId %></td>
          <td><%= a.assetName %></td>
          <td><%= a.type %></td>
          <td><%= a.serialNumber || '—' %></td>
          <td><%= a.assignedTo || 'Unassigned' %></td>
          <td><%= a.department %></td>
          <td><span class="badge badge-status-<%= a.status.toLowerCase().replace(/ /g,'-') %>"><%= a.status %></span></td>
        </tr>
      <% }) %>
      <% if (assets.length === 0) { %>
        <tr><td colspan="7" class="empty-row">No assets match your filters.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
