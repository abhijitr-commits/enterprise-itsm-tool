<%- include('../partials/header', { title: request.requestId }) %>

<div class="page-header">
  <h1><%= request.requestId %> — <%= request.catalogItem %></h1>
  <div class="header-actions">
    <% if (request.approvalStatus === APPROVAL.PENDING) { %>
      <form method="post" action="/requests/<%= request._id %>/decide" onsubmit="return confirm('Approve this request?')">
        <input type="hidden" name="decision" value="Approved" />
        <button class="btn btn-primary" type="submit">Approve</button>
      </form>
      <form method="post" action="/requests/<%= request._id %>/decide" onsubmit="return confirm('Reject this request?')">
        <input type="hidden" name="decision" value="Rejected" />
        <button class="btn btn-danger" type="submit">Reject</button>
      </form>
    <% } %>
    <% if (request.fulfillmentStatus !== 'Closed') { %>
      <form method="post" action="/requests/<%= request._id %>/close" onsubmit="return confirm('Close this request?')">
        <button class="btn btn-secondary" type="submit">Close Request</button>
      </form>
    <% } %>
  </div>
</div>

<% if (justCreated) { %><div class="alert alert-success">Service request submitted successfully.</div><% } %>

<div class="detail-grid">
  <form class="panel form-panel" method="post" action="/requests/<%= request._id %>">
    <div class="form-grid">
      <label>Requester
        <input type="text" name="requester" value="<%= request.requester %>" required />
      </label>
      <label>Department
        <input type="text" name="department" value="<%= request.department %>" required />
      </label>
      <label>Catalog Item
        <input type="text" name="catalogItem" value="<%= request.catalogItem %>" required />
      </label>
      <label>Fulfillment Status
        <select name="fulfillmentStatus">
          <% Object.values(STATUS).forEach(function(s){ %>
            <option value="<%= s %>" <%= request.fulfillmentStatus === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <label>Details
      <textarea name="details" rows="5" required><%= request.details %></textarea>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
  </form>

  <div class="panel">
    <div class="panel-header"><h2>Details</h2></div>
    <dl class="meta-list">
      <dt>Created</dt><dd><%= new Date(request.createdDate).toLocaleString() %></dd>
      <dt>Created By</dt><dd><%= request.createdBy %></dd>
      <dt>Approval Status</dt><dd><span class="badge badge-approval-<%= request.approvalStatus.toLowerCase().replace(/ /g,'-') %>"><%= request.approvalStatus %></span></dd>
      <dt>Approver</dt><dd><%= request.approver || '—' %></dd>
      <dt>Closed</dt><dd><%= request.closedDate ? new Date(request.closedDate).toLocaleString() : '—' %></dd>
    </dl>

    <div class="panel-header"><h2>Comments</h2></div>
    <div class="comment-list">
      <% (request.comments || []).forEach(function(c) { %>
        <div class="comment">
          <div class="comment-meta"><%= new Date(c.createdAt).toLocaleString() %><% if (c.isInternal) { %> · internal<% } %></div>
          <div class="comment-text"><%= c.text %></div>
        </div>
      <% }) %>
      <% if ((request.comments || []).length === 0) { %><p class="empty-row">No comments yet.</p><% } %>
    </div>
    <form method="post" action="/requests/<%= request._id %>/comments" class="comment-form">
      <textarea name="text" rows="2" placeholder="Add a comment…" required></textarea>
      <label class="checkbox-label"><input type="checkbox" name="isInternal" /> Internal note</label>
      <button type="submit" class="btn btn-secondary btn-block">Add Comment</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
