<%- include('../partials/header', { title: 'Stock Management' }) %>

<div class="page-header">
  <h1>Stock Management</h1>
  <div style="display:flex; gap:8px;">
    <a class="btn btn-secondary" href="/admin/stock/orders">Stock Orders</a>
    <a class="btn btn-secondary" href="/admin/stock<%= criticalOnly ? '' : '?critical=1' %>"><%= criticalOnly ? 'Show All Items' : 'Show Critical Only' %></a>
    <a class="btn btn-primary" href="/admin/stock/new">+ Add Stock Item</a>
  </div>
</div>

<p class="hint">Same fields and calculations as the Inventory sheet: Closing Stock (PC) = Opening Stock + Received − Issued/Used, never stored as an editable number. Status is CRITICAL once Closing Stock falls to or below Minimum Buffer Stock.</p>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <div class="table-scroll">
  <table class="table">
    <thead>
      <tr>
        <th>Item Code</th><th>Item Name</th><th>Category</th><th>Location</th>
        <th>PC per Box</th><th>Minimum Buffer Stock</th>
        <th>Issued / Used (PC)</th><th>Closing Stock (PC)</th><th>Display Stock</th>
        <th>Status</th><th>Order</th><th>Qty to Order</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(i) { %>
        <tr>
          <td><a href="/admin/stock/<%= i.itemId %>/transactions"><%= i.itemCode || i.itemId %></a></td>
          <td><%= i.itemName %></td>
          <td><%= i.category %></td>
          <td><%= i.location || '—' %></td>
          <td><%= i.piecesPerBox %></td>
          <td><%= i.minBufferStock %> <%= i.unit %></td>
          <td><%= i.issuedUsed %></td>
          <td><%= i.closingStock %> <%= i.unit %></td>
          <td><%= i.displayStock %></td>
          <td><span class="badge <%= i.status === 'CRITICAL' ? 'badge-status-cancelled' : 'badge-status-open' %>"><%= i.status %></span></td>
          <td><span class="badge <%= i.orderFlag === 'Done' ? 'badge-status-resolved' : (i.orderFlag === 'Order' ? 'badge-status-in-progress' : 'badge-status-on-hold') %>"><%= i.orderFlag.toUpperCase() %></span></td>
          <td><%= i.qtyToOrder %></td>
          <td>
            <form method="post" action="/admin/stock/<%= i.itemId %>/transactions" class="filter-bar">
              <select name="type">
                <option value="IN">IN</option>
                <option value="OUT">OUT</option>
              </select>
              <input type="number" name="quantity" min="1" placeholder="Qty (pc)" style="width:80px;" required />
              <input type="text" name="reason" placeholder="Reason/Reference" style="width:140px;" />
              <button type="submit" class="btn btn-secondary">Record</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (items.length === 0) { %><tr><td colspan="13" class="empty-row">No stock items yet.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>

<%- include('../partials/footer') %>
