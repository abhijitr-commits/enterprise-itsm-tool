<%- include('../partials/header', { title: item.itemName + ' — Transactions' }) %>

<div class="page-header">
  <h1><%= item.itemName %> <span class="hint"><%= item.itemCode || item.itemId %></span></h1>
  <span class="badge <%= item.status === 'CRITICAL' ? 'badge-status-cancelled' : 'badge-status-open' %>"><%= item.displayStock %> — <%= item.status %></span>
</div>

<div class="panel">
  <dl class="meta-list">
    <dt>Category</dt><dd><%= item.category %></dd>
    <dt>Location</dt><dd><%= item.location || '—' %></dd>
    <dt>PC per Box</dt><dd><%= item.piecesPerBox %></dd>
    <dt>Opening Stock</dt><dd><%= item.openingStock %> <%= item.unit %></dd>
    <dt>Minimum Buffer Stock</dt><dd><%= item.minBufferStock %> <%= item.unit %></dd>
    <dt>Issued / Used (PC)</dt><dd><%= item.issuedUsed %></dd>
    <dt>Closing Stock (PC)</dt><dd><%= item.closingStock %> <%= item.unit %></dd>
    <dt>Qty to Order</dt><dd><%= item.qtyToOrder %></dd>
    <dt>Order</dt><dd><span class="badge <%= item.orderFlag === 'Done' ? 'badge-status-resolved' : (item.orderFlag === 'Order' ? 'badge-status-in-progress' : 'badge-status-on-hold') %>"><%= item.orderFlag.toUpperCase() %></span></dd>
    <dt>Remarks</dt><dd><%= item.remarks || '—' %></dd>
  </dl>
</div>

<div class="panel">
  <div class="panel-header"><h2>Transaction History</h2></div>
  <table class="table">
    <thead><tr><th>Transaction ID</th><th>Type</th><th>Quantity</th><th>Reason/Reference</th><th>Date</th><th>Performed By</th></tr></thead>
    <tbody>
      <% transactions.forEach(function(t) { %>
        <tr>
          <td><%= t.transactionId %></td>
          <td><span class="badge <%= t.type === 'IN' ? 'badge-status-resolved' : 'badge-status-open' %>"><%= t.type %></span></td>
          <td><%= t.quantity %></td>
          <td><%= t.reason || '—' %></td>
          <td><%= new Date(t.date).toLocaleString() %></td>
          <td><%= t.performedBy %></td>
        </tr>
      <% }) %>
      <% if (transactions.length === 0) { %><tr><td colspan="6" class="empty-row">No transactions recorded yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<a class="btn btn-secondary" href="/admin/stock">Back to Stock Management</a>

<%- include('../partials/footer') %>
