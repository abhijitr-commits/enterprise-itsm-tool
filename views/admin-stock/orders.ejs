<%- include('../partials/header', { title: 'Stock Orders' }) %>

<div class="page-header">
  <h1>Stock Order Management</h1>
  <div style="display:flex; gap:8px;">
    <a class="btn btn-secondary" href="/admin/stock">Stock Management</a>
    <a class="btn btn-primary" href="/admin/stock/orders/new">+ Raise Order</a>
  </div>
</div>

<%- include('../partials/csvActions', { moduleKey: 'adminStockOrder' }) %>

<p class="hint">Same fields as the Order Register sheet — raise an order against an item, then mark it received once goods arrive to update stock and record the bill/payment. Raising an order sets that item's Order flag to ORDER; marking it received sets it to DONE.</p>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <div class="table-scroll">
  <table class="table">
    <thead>
      <tr>
        <th>Order ID</th><th>Item Code</th><th>Item Name</th><th>PC per Box</th><th>Order Date</th><th>Status</th>
        <th>Received Boxes</th><th>Received Loose PC</th><th>Received Stock (PC)</th>
        <th>Reference Bill No</th><th>Payment Status</th><th>Payment Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(function(o) { %>
        <tr>
          <td><%= o.orderId %></td>
          <td><%= o.itemCode || '—' %></td>
          <td><%= o.itemName %></td>
          <td><%= o.piecesPerBox %></td>
          <td><%= o.orderDate ? new Date(o.orderDate).toLocaleDateString() : '—' %></td>
          <td><span class="badge <%= o.status === 'Received' ? 'badge-status-resolved' : 'badge-status-in-progress' %>"><%= o.status %></span></td>
          <td><%= o.status === 'Received' ? o.receivedBoxes : '—' %></td>
          <td><%= o.status === 'Received' ? o.receivedLoosePieces : '—' %></td>
          <td><%= o.status === 'Received' ? o.receivedStockPieces : '—' %></td>
          <td><%= o.referenceBillNo || '—' %></td>
          <td><% if (o.status === 'Received') { %><span class="badge <%= o.paymentStatus === 'Paid' ? 'badge-status-resolved' : 'badge-status-cancelled' %>"><%= o.paymentStatus %></span><% } else { %>—<% } %></td>
          <td><%= o.paymentDate ? new Date(o.paymentDate).toLocaleDateString() : '—' %></td>
          <td>
            <% if (o.status === 'Pending') { %>
              <details>
                <summary class="btn btn-secondary" style="display:inline-block; cursor:pointer;">Mark Received</summary>
                <form method="post" action="/admin/stock/orders/<%= o.orderId %>/receive" class="filter-bar" style="margin-top:8px; flex-wrap:wrap;">
                  <input type="number" name="receivedBoxes" min="0" placeholder="Received Boxes" style="width:110px;" />
                  <input type="number" name="receivedLoosePieces" min="0" placeholder="Received Loose PC" style="width:120px;" />
                  <input type="text" name="referenceBillNo" placeholder="Reference Bill No" style="width:130px;" />
                  <select name="paymentStatus">
                    <option value="Pending">Payment Pending</option>
                    <option value="Paid">Paid</option>
                  </select>
                  <input type="date" name="paymentDate" style="width:140px;" />
                  <button type="submit" class="btn btn-primary">Confirm</button>
                </form>
              </details>
            <% } else if (o.paymentStatus !== 'Paid') { %>
              <form method="post" action="/admin/stock/orders/<%= o.orderId %>/payment" class="filter-bar">
                <input type="hidden" name="paymentStatus" value="Paid" />
                <input type="date" name="paymentDate" style="width:140px;" />
                <button type="submit" class="btn btn-secondary">Mark Paid</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (orders.length === 0) { %><tr><td colspan="13" class="empty-row">No stock orders yet.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>

<%- include('../partials/footer') %>
