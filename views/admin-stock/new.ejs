<%- include('../partials/header', { title: 'Add Stock Item' }) %>

<div class="page-header">
  <h1>Add Stock Item</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form class="panel form-panel" method="post" action="/admin/stock">
  <div class="form-grid">
    <label>Item Code
      <input type="text" name="itemCode" value="<%= form.itemCode || '' %>" />
    </label>
    <label>Item Name
      <input type="text" name="itemName" value="<%= form.itemName || '' %>" required />
    </label>
    <label>Category
      <input type="text" name="category" value="<%= form.category || '' %>" placeholder="General" />
    </label>
    <label>Unit
      <input type="text" name="unit" value="<%= form.unit || '' %>" placeholder="pcs" />
    </label>
    <label>PC per Box
      <input type="number" name="piecesPerBox" min="1" value="<%= form.piecesPerBox || 1 %>" />
    </label>
    <label>Opening Boxes
      <input type="number" name="openingBoxes" min="0" value="<%= form.openingBoxes || 0 %>" />
    </label>
    <label>Opening Loose PC
      <input type="number" name="openingLoosePieces" min="0" value="<%= form.openingLoosePieces || 0 %>" />
    </label>
    <label>Minimum Buffer Stock
      <input type="number" name="minBufferStock" min="0" value="<%= form.minBufferStock || 0 %>" />
    </label>
    <label>Order
      <select name="orderFlag">
        <option value="Hold" <%= (form.orderFlag || 'Hold') === 'Hold' ? 'selected' : '' %>>Hold</option>
        <option value="Order" <%= form.orderFlag === 'Order' ? 'selected' : '' %>>Order</option>
        <option value="Done" <%= form.orderFlag === 'Done' ? 'selected' : '' %>>Done</option>
      </select>
    </label>
    <label>Location
      <input type="text" name="location" value="<%= form.location || '' %>" />
    </label>
  </div>
  <label>Remarks
    <textarea name="remarks" rows="2"><%= form.remarks || '' %></textarea>
  </label>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/admin/stock">Cancel</a>
    <button type="submit" class="btn btn-primary">Save</button>
  </div>
</form>

<%- include('../partials/footer') %>
