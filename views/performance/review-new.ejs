<%- include('../partials/header', { title: 'New Performance Review' }) %>

<div class="page-header">
  <h1>Submit a Performance Review</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form class="panel form-panel" method="post" action="/performance/reviews">
  <div class="form-grid">
    <label>Employee (name)
      <input type="text" name="employee" value="<%= form.employee || '' %>" required />
    </label>
    <label>Review Period
      <input type="text" name="reviewPeriod" placeholder="e.g. H1 2026" value="<%= form.reviewPeriod || '' %>" required />
    </label>
    <label>Rating (1-5)
      <input type="number" name="rating" min="1" max="5" value="<%= form.rating || '' %>" required />
    </label>
  </div>
  <label>Strengths
    <textarea name="strengths" rows="3"><%= form.strengths || '' %></textarea>
  </label>
  <label>Areas for Improvement
    <textarea name="areasForImprovement" rows="3"><%= form.areasForImprovement || '' %></textarea>
  </label>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/performance/reviews">Cancel</a>
    <button type="submit" class="btn btn-primary">Submit Review</button>
  </div>
</form>

<%- include('../partials/footer') %>
