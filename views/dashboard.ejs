<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="page-header">
  <h1>Dashboard</h1>
  <div class="header-actions">
    <a class="btn btn-primary" href="/rooms/bookings/new"><%- icon('calendar', {size:15}) %> Book a Room</a>
  </div>
</div>

<% if ((activeMajorIncidents || []).length > 0) { %>
  <div class="alert alert-error" style="margin-bottom: 18px;">
    <strong>🚨 <%= activeMajorIncidents.length %> active Major Incident<%= activeMajorIncidents.length === 1 ? '' : 's' %></strong>
    <ul style="margin: 6px 0 0 18px;">
      <% activeMajorIncidents.forEach(function(mi) { %>
        <li><a href="/incidents/<%= mi._id %>"><%= mi.incidentId %></a> — <%= mi.subject %>
          <span class="badge badge-priority-<%= mi.priority.toLowerCase() %>"><%= mi.priority %></span>
          <% if (mi.engineer) { %>· <%= mi.engineer %><% } %>
        </li>
      <% }) %>
    </ul>
    <a href="/incidents/major">View the war room board →</a>
  </div>
<% } %>

<%
  var dOpen = open, dProg = inProgress, dHold = onHold, dRes = resolved;
  var dTotal = dOpen + dProg + dHold + dRes;
  var donutSegs = [
    { label: 'Open', value: dOpen, color: 'var(--primary)' },
    { label: 'In Progress', value: dProg, color: 'var(--info)' },
    { label: 'On Hold', value: dHold, color: 'var(--warning)' },
    { label: 'Resolved', value: dRes, color: 'var(--success)' }
  ];
  var donutCum = 0;
  var donutParts = [];
  donutSegs.forEach(function(s) {
    if (dTotal > 0 && s.value > 0) {
      var start = (donutCum / dTotal) * 100;
      donutCum += s.value;
      var end = (donutCum / dTotal) * 100;
      donutParts.push(s.color + ' ' + start.toFixed(2) + '% ' + end.toFixed(2) + '%');
    }
  });
  var donutStyle = dTotal > 0 ? ('background: conic-gradient(' + donutParts.join(', ') + ');') : '';

  var chartW = 600, chartH = 120;
  var maxCount = Math.max.apply(null, trend.map(function (t) { return t.count; }).concat([1]));
  var stepX = chartW / (trend.length - 1);
  var trendPoints = trend.map(function (t, i) {
    return { x: i * stepX, y: (chartH - 8) * (1 - t.count / maxCount) + 4, count: t.count };
  });
  var trendLinePath = trendPoints.map(function (p, i) { return (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ' ' + p.y.toFixed(1); }).join(' ');
  var trendAreaPath = trendLinePath + ' L ' + trendPoints[trendPoints.length - 1].x.toFixed(1) + ' ' + chartH + ' L 0 ' + chartH + ' Z';
  var trendTotal = trend.reduce(function (sum, t) { return sum + t.count; }, 0);
%>
<div class="dashboard-grid">
  <div class="panel">
    <div class="panel-header"><h2>Departments</h2></div>
    <div class="dept-tile-grid">
      <a class="dept-tile dept-tile-blue" href="/hr">
        <span class="dept-tile-icon"><%- icon('users', {size:22}) %></span>
        <div class="dept-tile-title">HR Hub <%- icon('chevron-right', {size:16}) %></div>
        <div class="dept-tile-sub">People, Time Off, Onboarding/Offboarding, Letters, Training, and more.</div>
      </a>
      <a class="dept-tile dept-tile-indigo" href="/it">
        <span class="dept-tile-icon"><%- icon('monitor', {size:22}) %></span>
        <div class="dept-tile-title">IT Management Hub <%- icon('chevron-right', {size:16}) %></div>
        <div class="dept-tile-sub">Helpdesk, Assets, Licensing, Vendors, and IT operations.</div>
      </a>
      <a class="dept-tile dept-tile-amber" href="/operations">
        <span class="dept-tile-icon"><%- icon('factory', {size:22}) %></span>
        <div class="dept-tile-title">Operations Hub <%- icon('chevron-right', {size:16}) %></div>
        <div class="dept-tile-sub">Sales, Production, Logistics, Safety, and Facilities.</div>
      </a>
      <a class="dept-tile dept-tile-rose" href="/wellness/programs">
        <span class="dept-tile-icon"><%- icon('heart', {size:22}) %></span>
        <div class="dept-tile-title">Wellness <%- icon('chevron-right', {size:16}) %></div>
        <div class="dept-tile-sub">Wellness Programs, Pulse Surveys, and the Kudos Wall.</div>
      </a>
      <a class="dept-tile dept-tile-teal" href="/itsm">
        <span class="dept-tile-icon"><%- icon('alert-circle', {size:22}) %></span>
        <div class="dept-tile-title">ITSM <%- icon('chevron-right', {size:16}) %></div>
        <div class="dept-tile-sub">Incidents, Requests, Problems, Changes, Assets, CMDB, Knowledge Base, and Reports.</div>
      </a>
      <a class="dept-tile dept-tile-purple" href="/portal">
        <span class="dept-tile-icon"><%- icon('search', {size:22}) %></span>
        <div class="dept-tile-title">Service Portal <%- icon('chevron-right', {size:16}) %></div>
        <div class="dept-tile-sub">Search the Knowledge Base first, then file a request or incident if you still need to.</div>
      </a>
      <% if (isAdminTeamUser) { %>
        <a class="dept-tile dept-tile-slate" href="/admin/ops">
          <span class="dept-tile-icon"><%- icon('grid', {size:22}) %></span>
          <div class="dept-tile-title">Admin Operations <%- icon('chevron-right', {size:16}) %></div>
          <div class="dept-tile-sub">Vendors, Stock, Scrap, Assets, Purchases, and Facilities.</div>
        </a>
      <% } %>
      <% if (currentUser && currentUser.role === 'Administrator') { %>
        <a class="dept-tile dept-tile-purple" href="/admin">
          <span class="dept-tile-icon"><%- icon('settings', {size:22}) %></span>
          <div class="dept-tile-title">Admin Console <%- icon('chevron-right', {size:16}) %></div>
          <div class="dept-tile-sub">Users, Permissions, Integrations, and Master Data.</div>
        </a>
      <% } %>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header"><h2>Active Ticket Status</h2></div>
    <% if (dTotal === 0) { %>
      <p class="donut-empty">No active incidents right now — nice work!</p>
    <% } else { %>
      <div class="donut-wrap">
        <div class="donut" style="<%= donutStyle %>">
          <div class="donut-center">
            <div class="donut-center-value"><%= dTotal %></div>
            <div class="donut-center-label">Active</div>
          </div>
        </div>
        <div class="donut-legend">
          <% donutSegs.forEach(function(s) { %>
            <% if (s.value > 0) { %>
            <div class="donut-legend-item">
              <span class="donut-legend-dot" style="background: <%= s.color %>"></span>
              <span class="donut-legend-label"><%= s.label %></span>
              <span class="donut-legend-value"><%= s.value %></span>
            </div>
            <% } %>
          <% }) %>
        </div>
      </div>
      <div class="breakdown-bars">
        <% donutSegs.forEach(function(s) { %>
          <% if (s.value > 0) { %>
            <% var pct = (s.value / dTotal * 100); %>
            <div class="breakdown-bar-row">
              <div class="breakdown-bar-label"><span><%= s.label %></span><span><%= pct.toFixed(0) %>%</span></div>
              <div class="breakdown-bar-track"><div class="breakdown-bar-fill" style="width: <%= pct.toFixed(1) %>%; background: <%= s.color %>;"></div></div>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><h2>Incident Volume — Last 14 Days</h2></div>
  <div class="trend-chart-head">
    <span class="trend-chart-value"><%= trendTotal %></span>
    <span class="trend-chart-sub">new incidents logged</span>
  </div>
  <svg class="trend-chart-svg" viewBox="0 0 <%= chartW %> <%= chartH %>">
    <defs>
      <linearGradient id="trendGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#f97316" stop-opacity="0.32"/>
        <stop offset="100%" stop-color="#f97316" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <path class="trend-area" d="<%= trendAreaPath %>"></path>
    <path class="trend-line" d="<%= trendLinePath %>"></path>
    <% trendPoints.forEach(function(p) { %>
      <circle class="trend-dot" cx="<%= p.x.toFixed(1) %>" cy="<%= p.y.toFixed(1) %>" r="2.5"></circle>
    <% }) %>
  </svg>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-card-body">
      <div class="stat-value"><%= open %></div>
      <div class="stat-label">Open Incidents</div>
    </div>
    <span class="stat-icon"><%- icon('alert-circle') %></span>
  </div>
  <div class="stat-card stat-info">
    <div class="stat-card-body">
      <div class="stat-value"><%= inProgress %></div>
      <div class="stat-label">In Progress</div>
    </div>
    <span class="stat-icon"><%- icon('clock') %></span>
  </div>
  <div class="stat-card stat-danger">
    <div class="stat-card-body">
      <div class="stat-value"><%= breached %></div>
      <div class="stat-label">SLA Breached</div>
    </div>
    <span class="stat-icon"><%- icon('alert-triangle') %></span>
  </div>
  <div class="stat-card stat-success">
    <div class="stat-card-body">
      <div class="stat-value"><%= closedToday %></div>
      <div class="stat-label">Closed Today</div>
    </div>
    <span class="stat-icon"><%- icon('check-circle') %></span>
  </div>
  <div class="stat-card stat-warning">
    <div class="stat-card-body">
      <div class="stat-value"><%= pendingApprovals %></div>
      <div class="stat-label">Pending Approvals</div>
    </div>
    <span class="stat-icon"><%- icon('clipboard-check') %></span>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    <h2>Recent Incidents</h2>
    <a class="btn btn-primary" href="/incidents/new">+ New Incident</a>
  </div>
  <table class="table">
    <thead>
      <tr><th>ID</th><th>Subject</th><th>Priority</th><th>Status</th><th>Engineer</th></tr>
    </thead>
    <tbody>
      <% recent.forEach(function(inc) { %>
        <tr onclick="location.href='/incidents/<%= inc._id %>'">
          <td><%= inc.incidentId %></td>
          <td><%= inc.subject %></td>
          <td><span class="badge badge-priority-<%= inc.priority.toLowerCase() %>"><%= inc.priority %></span></td>
          <td><span class="badge badge-status-<%= inc.status.toLowerCase().replace(/ /g,'-') %>"><%= inc.status %></span></td>
          <td>
            <% if (inc.engineer) { %><span class="avatar avatar-xs"><%= initials(inc.engineer) %></span> <%= inc.engineer %><% } else { %>—<% } %>
          </td>
        </tr>
      <% }) %>
      <% if (recent.length === 0) { %>
        <tr><td colspan="5" class="empty-row">No incidents yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
