<%- include('../partials/header', { title: type + ' Checklist' }) %>

<div class="page-header">
  <h1><%= type %> Checklist</h1>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="tab-bar">
  <% tabs.forEach(function(t) { %>
    <a class="tab <%= t.slug === slug ? 'tab-active' : '' %>" href="/onboarding/<%= t.slug %>"><%= t.label %></a>
  <% }) %>
</div>

<div class="panel">
  <div class="panel-header">
    <h2>Start a New Checklist</h2>
  </div>
  <div class="alert alert-info">
    Pick a name below and click Create — the standard <%= standardTasks.length %>-step <%= type %> checklist
    (<%= standardTasks.map(function(t){ return t[0]; }).join(', ') %>) loads instantly, ready to check off. Nothing to build yourself.
  </div>
  <form method="post" action="/onboarding/<%= slug %>" class="filter-bar" id="checklist-create-form">
    <select name="employee" id="checklist-employee-select" required>
      <option value="">— Select a name —</option>
      <% if (candidateOptions.length) { %>
        <optgroup label="Hired Candidates">
          <% candidateOptions.forEach(function(c) { %>
            <option value="<%= c.name %>" data-department="<%= c.department %>"><%= c.name %></option>
          <% }) %>
        </optgroup>
      <% } %>
      <% if (employeeOptions.length) { %>
        <optgroup label="Employee Directory">
          <% employeeOptions.forEach(function(e) { %>
            <option value="<%= e.name %>" data-department="<%= e.department %>"><%= e.name %></option>
          <% }) %>
        </optgroup>
      <% } %>
      <option value="__other__">Other (type a name manually)…</option>
    </select>
    <input type="text" name="employeeManual" id="checklist-employee-manual" placeholder="Name" style="display:none" />
    <input type="text" name="department" id="checklist-department" placeholder="Department" />
    <button type="submit" class="btn btn-primary">Create</button>
  </form>
</div>

<script>
  (function () {
    var select = document.getElementById('checklist-employee-select');
    var manual = document.getElementById('checklist-employee-manual');
    var dept = document.getElementById('checklist-department');
    var form = document.getElementById('checklist-create-form');
    select.addEventListener('change', function () {
      var opt = select.options[select.selectedIndex];
      if (select.value === '__other__') {
        manual.style.display = '';
        manual.focus();
        dept.value = '';
      } else {
        manual.style.display = 'none';
        manual.value = '';
        dept.value = (opt && opt.getAttribute('data-department')) || '';
      }
    });
    form.addEventListener('submit', function () {
      if (select.value === '__other__') {
        select.name = '';
        manual.name = 'employee';
      }
    });
  })();
</script>

<% groups.forEach(function(group) { %>
  <div class="panel">
    <div class="panel-header">
      <h2><%= group.employee %> <span class="hint"><%= group.department || '' %></span></h2>
      <% if (slug === 'pre-onboarding') { %>
        <a class="btn btn-secondary" href="/onboarding/pre-onboarding/<%= encodeURIComponent(group.employee) %>/detail">Pre-Onboarding Details</a>
      <% } %>
    </div>
    <table class="table">
      <thead><tr><th>Task</th><th>Category</th><th>Status</th><th>Completed</th><th></th></tr></thead>
      <tbody>
        <% group.tasks.forEach(function(t) { %>
          <tr>
            <td><%= t.task %></td>
            <td><%= t.category || '—' %></td>
            <td><span class="badge <%= t.status === 'Done' ? 'badge-status-resolved' : 'badge-status-open' %>"><%= t.status %></span></td>
            <td><%= t.completedDate ? new Date(t.completedDate).toLocaleDateString() : '—' %></td>
            <td>
              <form method="post" action="/onboarding/<%= slug %>/<%= t._id %>/toggle">
                <input type="hidden" name="done" value="<%= t.status === 'Done' ? '0' : '1' %>" />
                <button type="submit" class="btn btn-secondary"><%= t.status === 'Done' ? 'Mark Pending' : 'Mark Done' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% }) %>
<% if (groups.length === 0) { %>
  <div class="panel empty-row">No <%= type.toLowerCase() %> checklists yet.</div>
<% } %>

<%- include('../partials/footer') %>
