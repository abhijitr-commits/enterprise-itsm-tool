<%- include('../partials/header', { title: 'Reports' }) %>

<div class="page-header">
  <h1>Reports</h1>
  <div class="header-actions">
    <a class="btn btn-secondary" href="/itsm">← ITSM Hub</a>
  </div>
</div>

<%
  // ---- BI Dashboard (Architecture Phase 3) ----
  // Same inline-SVG/CSS-conic-gradient charting technique already used on
  // the main Dashboard (views/dashboard.ejs) — no charting library, just
  // plain math + SVG, so this stays free and dependency-free.
  var biVolTotal = biVolumeTrend.reduce(function (s, m) { return s + m.total; }, 0);
  var biVolMax = Math.max.apply(null, biVolumeTrend.map(function (m) { return m.total; }).concat([1]));
  var biChartW = 600, biChartH = 110;
  var biVolStepX = biChartW / (biVolumeTrend.length - 1);
  var biVolPoints = biVolumeTrend.map(function (m, i) {
    return { x: i * biVolStepX, y: (biChartH - 8) * (1 - m.total / biVolMax) + 4, count: m.total, label: m.month };
  });
  var biVolLine = biVolPoints.map(function (p, i) { return (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ' ' + p.y.toFixed(1); }).join(' ');
  var biVolArea = biVolLine + ' L ' + biVolPoints[biVolPoints.length - 1].x.toFixed(1) + ' ' + biChartH + ' L 0 ' + biChartH + ' Z';

  var biMttrMax = Math.max.apply(null, biMttr.trend.map(function (m) { return m.avgHours; }).concat([1]));
  var biMttrStepX = biChartW / (biMttr.trend.length - 1);
  var biMttrPoints = biMttr.trend.map(function (m, i) {
    return { x: i * biMttrStepX, y: (biChartH - 8) * (1 - m.avgHours / biMttrMax) + 4, avgHours: m.avgHours, label: m.month };
  });
  var biMttrLine = biMttrPoints.map(function (p, i) { return (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ' ' + p.y.toFixed(1); }).join(' ');
  var biMttrArea = biMttrLine + ' L ' + biMttrPoints[biMttrPoints.length - 1].x.toFixed(1) + ' ' + biChartH + ' L 0 ' + biChartH + ' Z';

  var biSlaTotal = biSlaSummary.Met + biSlaSummary.Breached + biSlaSummary["At Risk"] + biSlaSummary["On Track"];
  var biSlaSegs = [
    { label: 'Met', value: biSlaSummary.Met, color: 'var(--success)' },
    { label: 'Breached', value: biSlaSummary.Breached, color: 'var(--danger, #dc2626)' },
    { label: 'At Risk', value: biSlaSummary["At Risk"], color: 'var(--warning)' },
    { label: 'On Track', value: biSlaSummary["On Track"], color: 'var(--info)' },
  ];
  var biSlaCum = 0, biSlaParts = [];
  biSlaSegs.forEach(function (s) {
    if (biSlaTotal > 0 && s.value > 0) {
      var start = (biSlaCum / biSlaTotal) * 100;
      biSlaCum += s.value;
      var end = (biSlaCum / biSlaTotal) * 100;
      biSlaParts.push(s.color + ' ' + start.toFixed(2) + '% ' + end.toFixed(2) + '%');
    }
  });
  var biSlaDonutStyle = biSlaTotal > 0 ? ('background: conic-gradient(' + biSlaParts.join(', ') + ');') : '';
%>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-card-body">
      <div class="stat-value"><%= biMttr.overallAvg !== null ? biMttr.overallAvg + 'h' : '—' %></div>
      <div class="stat-label">MTTR (avg resolution time)</div>
    </div>
    <span class="stat-icon"><%- icon('clock') %></span>
  </div>
  <div class="stat-card stat-success">
    <div class="stat-card-body">
      <div class="stat-value"><%= biSlaSummary.compliancePct !== null ? biSlaSummary.compliancePct + '%' : '—' %></div>
      <div class="stat-label">SLA Compliance</div>
    </div>
    <span class="stat-icon"><%- icon('check-circle') %></span>
  </div>
  <div class="stat-card stat-danger">
    <div class="stat-card-body">
      <div class="stat-value"><%= biChangeFailureRate.failureRatePct !== null ? biChangeFailureRate.failureRatePct + '%' : '—' %></div>
      <div class="stat-label">Change Failure Rate</div>
    </div>
    <span class="stat-icon"><%- icon('alert-triangle') %></span>
  </div>
  <div class="stat-card stat-info">
    <div class="stat-card-body">
      <div class="stat-value"><%= biVolTotal %></div>
      <div class="stat-label">Tickets (last 6 months)</div>
    </div>
    <span class="stat-icon"><%- icon('layers') %></span>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><h2>Ticket Volume Trend — Incidents + Requests + Problems + Changes</h2></div>
  <div class="trend-chart-head">
    <span class="trend-chart-value"><%= biVolTotal %></span>
    <span class="trend-chart-sub">tickets across all four modules, last 6 months</span>
  </div>
  <svg class="trend-chart-svg" viewBox="0 0 <%= biChartW %> <%= biChartH %>">
    <defs>
      <linearGradient id="biVolGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#6366f1" stop-opacity="0.32"/>
        <stop offset="100%" stop-color="#6366f1" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <path class="trend-area" d="<%= biVolArea %>" fill="url(#biVolGradient)"></path>
    <path class="trend-line" d="<%= biVolLine %>"></path>
    <% biVolPoints.forEach(function(p) { %>
      <circle class="trend-dot" cx="<%= p.x.toFixed(1) %>" cy="<%= p.y.toFixed(1) %>" r="2.5"></circle>
    <% }) %>
  </svg>
  <div class="hint" style="margin-top: 6px;">
    <% biVolumeTrend.forEach(function(m, i) { %><%= m.month %><% if (i < biVolumeTrend.length - 1) { %> · <% } %><% }) %>
  </div>
</div>

<div class="dashboard-grid">
  <div class="panel">
    <div class="panel-header"><h2>SLA Compliance Breakdown</h2></div>
    <% if (biSlaTotal === 0) { %>
      <p class="donut-empty">No incidents with an SLA status yet.</p>
    <% } else { %>
      <div class="donut-wrap">
        <div class="donut" style="<%= biSlaDonutStyle %>">
          <div class="donut-center">
            <div class="donut-center-value"><%= biSlaTotal %></div>
            <div class="donut-center-label">Incidents</div>
          </div>
        </div>
        <div class="donut-legend">
          <% biSlaSegs.forEach(function(s) { %>
            <% if (s.value > 0) { %>
            <div class="donut-legend-item">
              <span class="donut-legend-dot" style="background: <%= s.color %>"></span>
              <span class="donut-legend-label"><%= s.label %></span>
              <span class="donut-legend-value"><%= s.value %></span>
            </div>
            <% } %>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-header"><h2>Change Failure Rate</h2></div>
    <% if (biChangeFailureRate.completed === 0) { %>
      <p class="donut-empty">No changes have reached Implemented or Rolled Back yet.</p>
    <% } else { %>
      <div class="breakdown-bars">
        <div class="breakdown-bar-row">
          <div class="breakdown-bar-label"><span>Implemented</span><span><%= biChangeFailureRate.implemented %></span></div>
          <div class="breakdown-bar-track"><div class="breakdown-bar-fill" style="width: <%= (biChangeFailureRate.implemented / biChangeFailureRate.completed * 100).toFixed(1) %>%; background: var(--success);"></div></div>
        </div>
        <div class="breakdown-bar-row">
          <div class="breakdown-bar-label"><span>Rolled Back</span><span><%= biChangeFailureRate.rolledBack %></span></div>
          <div class="breakdown-bar-track"><div class="breakdown-bar-fill" style="width: <%= (biChangeFailureRate.rolledBack / biChangeFailureRate.completed * 100).toFixed(1) %>%; background: var(--danger, #dc2626);"></div></div>
        </div>
      </div>
      <p class="hint" style="margin-top: 10px;">
        <%= biChangeFailureRate.failureRatePct %>% of completed changes (<%= biChangeFailureRate.completed %> total) had to be rolled back —
        see each one's root cause / corrective action / lessons learned on its Change record for why.
      </p>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><h2>Mean Time To Resolve (MTTR) Trend — Incidents</h2></div>
  <div class="trend-chart-head">
    <span class="trend-chart-value"><%= biMttr.overallAvg !== null ? biMttr.overallAvg + 'h' : '—' %></span>
    <span class="trend-chart-sub">average resolution time across <%= biMttr.resolvedCount %> resolved incident(s)</span>
  </div>
  <svg class="trend-chart-svg" viewBox="0 0 <%= biChartW %> <%= biChartH %>">
    <defs>
      <linearGradient id="biMttrGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#0ea5e9" stop-opacity="0.32"/>
        <stop offset="100%" stop-color="#0ea5e9" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <path class="trend-area" d="<%= biMttrArea %>" fill="url(#biMttrGradient)"></path>
    <path class="trend-line" d="<%= biMttrLine %>" style="stroke: #0ea5e9;"></path>
    <% biMttrPoints.forEach(function(p) { %>
      <circle class="trend-dot" cx="<%= p.x.toFixed(1) %>" cy="<%= p.y.toFixed(1) %>" r="2.5" style="fill: #0ea5e9;"></circle>
    <% }) %>
  </svg>
  <div class="hint" style="margin-top: 6px;">
    <% biMttr.trend.forEach(function(m, i) { %><%= m.month %> (<%= m.avgHours %>h)<% if (i < biMttr.trend.length - 1) { %> · <% } %><% }) %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><h2>SLA Compliance (Incidents)</h2></div>
  <table class="table">
    <thead><tr><th>ID</th><th>Subject</th><th>Priority</th><th>Status</th><th>Engineer</th><th>SLA Due</th><th>SLA Status</th></tr></thead>
    <tbody>
      <% sla.forEach(function(r){ %>
        <tr>
          <td><%= r.incidentId %></td><td><%= r.subject %></td>
          <td><span class="badge badge-priority-<%= r.priority.toLowerCase() %>"><%= r.priority %></span></td>
          <td><%= r.status %></td><td><%= r.engineer %></td><td><%= r.slaDue || '—' %></td>
          <td><span class="badge badge-approval-<%= r.slaStatus === 'Met' ? 'approved' : (r.slaStatus === 'Breached' ? 'rejected' : 'pending-approval') %>"><%= r.slaStatus %></span></td>
        </tr>
      <% }) %>
      <% if (sla.length === 0) { %><tr><td colspan="7" class="empty-row">No incidents yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Monthly Ticket Volume (Incidents)</h2></div>
  <table class="table">
    <thead><tr><th>Month</th><th>Incidents Created</th></tr></thead>
    <tbody>
      <% volume.forEach(function(v){ %><tr><td><%= v.month %></td><td><%= v.count %></td></tr><% }) %>
      <% if (volume.length === 0) { %><tr><td colspan="2" class="empty-row">No data yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Engineer Performance (Incidents)</h2></div>
  <table class="table">
    <thead><tr><th>Engineer</th><th>Assigned</th><th>Closed</th></tr></thead>
    <tbody>
      <% engineers.forEach(function(e){ %><tr><td><%= e.engineer %></td><td><%= e.assigned %></td><td><%= e.closed %></td></tr><% }) %>
      <% if (engineers.length === 0) { %><tr><td colspan="3" class="empty-row">No data yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Ticket Aging (Open Incidents)</h2></div>
  <table class="table">
    <thead><tr><th>ID</th><th>Subject</th><th>Priority</th><th>Engineer</th><th>Age</th><th>Bucket</th></tr></thead>
    <tbody>
      <% aging.forEach(function(a){ %>
        <tr>
          <td><%= a.incidentId %></td><td><%= a.subject %></td>
          <td><span class="badge badge-priority-<%= a.priority.toLowerCase() %>"><%= a.priority %></span></td>
          <td><%= a.engineer %></td><td><%= a.ageDays %> day(s)</td><td><%= a.bucket %></td>
        </tr>
      <% }) %>
      <% if (aging.length === 0) { %><tr><td colspan="6" class="empty-row">No open incidents.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Department Workload (Incidents + Service Requests)</h2></div>
  <table class="table">
    <thead><tr><th>Department</th><th>Incidents</th><th>Open Incidents</th><th>Requests</th></tr></thead>
    <tbody>
      <% workload.forEach(function(w){ %><tr><td><%= w.department %></td><td><%= w.incidents %></td><td><%= w.openIncidents %></td><td><%= w.requests %></td></tr><% }) %>
      <% if (workload.length === 0) { %><tr><td colspan="4" class="empty-row">No data yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Asset Warranty Expiry (next 90 days)</h2></div>
  <table class="table">
    <thead><tr><th>ID</th><th>Asset</th><th>Type</th><th>Department</th><th>Vendor</th><th>Expiry</th><th>Urgency</th></tr></thead>
    <tbody>
      <% warranty.forEach(function(w){ %>
        <tr>
          <td><%= w.assetId %></td><td><%= w.assetName %></td><td><%= w.type %></td>
          <td><%= w.department %></td><td><%= w.vendor || '—' %></td><td><%= w.warrantyExpiry %></td>
          <td><span class="badge badge-approval-<%= w.urgency === 'Expired' ? 'rejected' : 'pending-approval' %>"><%= w.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (warranty.length === 0) { %><tr><td colspan="7" class="empty-row">No assets expiring soon.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Contract Expiry (next 30 days)</h2></div>
  <table class="table">
    <thead><tr><th>ID</th><th>Name</th><th>Department</th><th>Designation</th><th>Contract End</th><th>Urgency</th></tr></thead>
    <tbody>
      <% contracts.forEach(function(c){ %>
        <tr>
          <td><%= c.employeeId %></td><td><%= c.name %></td><td><%= c.department %></td>
          <td><%= c.designation || '—' %></td><td><%= c.contractEndDate %></td>
          <td><span class="badge badge-approval-<%= c.urgency === 'Expired' ? 'rejected' : 'pending-approval' %>"><%= c.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (contracts.length === 0) { %><tr><td colspan="6" class="empty-row">No contracts expiring soon.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Vendor AMC Expiry (next 90 days)</h2></div>
  <table class="table">
    <thead><tr><th>Vendor</th><th>Category</th><th>AMC Expiry</th><th>Urgency</th></tr></thead>
    <tbody>
      <% amcs.forEach(function(a){ %>
        <tr>
          <td><%= a.vendorName %></td><td><%= a.category %></td><td><%= a.amcExpiry %></td>
          <td><span class="badge badge-approval-<%= a.urgency === 'Expired' ? 'rejected' : 'pending-approval' %>"><%= a.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (amcs.length === 0) { %><tr><td colspan="4" class="empty-row">No vendor AMCs expiring soon.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Admin Vendor AMC Expiry (next 90 days)</h2></div>
  <table class="table">
    <thead><tr><th>Vendor</th><th>Category</th><th>AMC Expiry</th><th>Urgency</th></tr></thead>
    <tbody>
      <% adminAmcs.forEach(function(a){ %>
        <tr>
          <td><%= a.vendorName %></td><td><%= a.category %></td><td><%= a.amcExpiry %></td>
          <td><span class="badge badge-approval-<%= a.urgency === 'Expired' ? 'rejected' : 'pending-approval' %>"><%= a.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (adminAmcs.length === 0) { %><tr><td colspan="4" class="empty-row">No admin vendor AMCs expiring soon.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Admin Stock — Critical / Low Items</h2></div>
  <table class="table">
    <thead><tr><th>Item</th><th>Category</th><th>Closing Stock (PC)</th><th>Minimum Buffer Stock</th><th>Qty to Order</th><th>Urgency</th></tr></thead>
    <tbody>
      <% adminStockCritical.forEach(function(s){ %>
        <tr>
          <td><%= s.itemName %></td><td><%= s.category %></td>
          <td><%= s.closingStock %> <%= s.unit %></td><td><%= s.minBufferStock %> <%= s.unit %></td><td><%= s.qtyToOrder %></td>
          <td><span class="badge badge-approval-<%= s.urgency === 'Out of Stock' ? 'rejected' : 'pending-approval' %>"><%= s.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (adminStockCritical.length === 0) { %><tr><td colspan="6" class="empty-row">No admin stock items are critical or low.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Pending Stock Orders</h2></div>
  <table class="table">
    <thead><tr><th>Order ID</th><th>Item Code</th><th>Item Name</th><th>Order Date</th><th>Raised By</th></tr></thead>
    <tbody>
      <% adminPendingOrders.forEach(function(o){ %>
        <tr>
          <td><%= o.orderId %></td><td><%= o.itemCode %></td><td><%= o.itemName %></td><td><%= o.orderDate %></td>
          <td><%= o.raisedBy %></td>
        </tr>
      <% }) %>
      <% if (adminPendingOrders.length === 0) { %><tr><td colspan="5" class="empty-row">No pending stock orders.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Scrap Management — Pending Approval</h2></div>
  <table class="table">
    <thead><tr><th>Scrap ID</th><th>Item</th><th>Category</th><th>Quantity</th><th>Reason</th><th>Scrap Date</th><th>Raised By</th></tr></thead>
    <tbody>
      <% adminScrapPending.forEach(function(s){ %>
        <tr>
          <td><%= s.scrapId %></td><td><%= s.itemName %></td><td><%= s.category %></td><td><%= s.quantity %></td>
          <td><%= s.reason %></td><td><%= s.scrapDate %></td><td><%= s.raisedBy %></td>
        </tr>
      <% }) %>
      <% if (adminScrapPending.length === 0) { %><tr><td colspan="7" class="empty-row">No scrap entries pending approval.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Admin Asset Warranty Expiry (next 90 days)</h2></div>
  <table class="table">
    <thead><tr><th>Asset</th><th>Type</th><th>Department</th><th>Vendor</th><th>Warranty Expiry</th><th>Urgency</th></tr></thead>
    <tbody>
      <% adminAssetWarranty.forEach(function(a){ %>
        <tr>
          <td><%= a.assetName %></td><td><%= a.type %></td><td><%= a.department %></td><td><%= a.vendor || '—' %></td><td><%= a.warrantyExpiry %></td>
          <td><span class="badge badge-approval-<%= a.urgency === 'Expired' ? 'rejected' : 'pending-approval' %>"><%= a.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (adminAssetWarranty.length === 0) { %><tr><td colspan="6" class="empty-row">No admin assets expiring soon.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Pending Purchase Approvals</h2></div>
  <table class="table">
    <thead><tr><th>PO ID</th><th>Item Description</th><th>Category</th><th>Quantity</th><th>Estimated Amount</th><th>Vendor</th><th>Raised By</th></tr></thead>
    <tbody>
      <% adminPendingPurchases.forEach(function(p){ %>
        <tr>
          <td><%= p.poId %></td><td><%= p.itemDescription %></td><td><%= p.category %></td><td><%= p.quantity %></td>
          <td><%= p.estimatedAmount %></td><td><%= p.vendor %></td><td><%= p.raisedBy %></td>
        </tr>
      <% }) %>
      <% if (adminPendingPurchases.length === 0) { %><tr><td colspan="7" class="empty-row">No purchase requests pending approval.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Facility Helpdesk — Open Requests</h2></div>
  <table class="table">
    <thead><tr><th>Complaint ID</th><th>Complainant</th><th>Category</th><th>Subject</th><th>Status</th><th>Raised On</th></tr></thead>
    <tbody>
      <% adminHelpdeskOpen.forEach(function(c){ %>
        <tr>
          <td><%= c.complaintId %></td><td><%= c.complainant %></td><td><%= c.category %></td><td><%= c.subject %></td>
          <td><span class="badge <%= c.status === 'Open' ? 'badge-status-open' : 'badge-status-in-progress' %>"><%= c.status %></span></td><td><%= c.createdDate %></td>
        </tr>
      <% }) %>
      <% if (adminHelpdeskOpen.length === 0) { %><tr><td colspan="6" class="empty-row">No open facility requests.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Facility Ops — Pending Tasks</h2></div>
  <table class="table">
    <thead><tr><th>Task ID</th><th>Task Name</th><th>Area</th><th>Assigned Staff</th><th>Frequency</th><th>Scheduled Date</th></tr></thead>
    <tbody>
      <% adminFacilityTasksPending.forEach(function(t){ %>
        <tr>
          <td><%= t.taskId %></td><td><%= t.taskName %></td><td><%= t.area %></td><td><%= t.assignedStaff %></td><td><%= t.frequency %></td><td><%= t.scheduledDate %></td>
        </tr>
      <% }) %>
      <% if (adminFacilityTasksPending.length === 0) { %><tr><td colspan="6" class="empty-row">No pending facility tasks.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Software License Expiry (next 90 days)</h2></div>
  <table class="table">
    <thead><tr><th>Software</th><th>Vendor</th><th>Expiry</th><th>Urgency</th></tr></thead>
    <tbody>
      <% licenses.forEach(function(l){ %>
        <tr>
          <td><%= l.softwareName %></td><td><%= l.vendor || '—' %></td><td><%= l.expiryDate %></td>
          <td><span class="badge badge-approval-<%= l.urgency === 'Expired' ? 'rejected' : 'pending-approval' %>"><%= l.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (licenses.length === 0) { %><tr><td colspan="4" class="empty-row">No software licenses expiring soon.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Calibration / Maintenance Due (next 90 days)</h2></div>
  <table class="table">
    <thead><tr><th>ID</th><th>Asset</th><th>Hardware Type</th><th>Department</th><th>Due</th><th>Urgency</th></tr></thead>
    <tbody>
      <% maintenanceDue.forEach(function(m){ %>
        <tr>
          <td><%= m.assetId %></td><td><%= m.assetName %></td><td><%= m.hardwareType %></td>
          <td><%= m.department %></td><td><%= m.nextMaintenanceDue %></td>
          <td><span class="badge badge-approval-<%= m.urgency === 'Overdue' ? 'rejected' : 'pending-approval' %>"><%= m.urgency %></span></td>
        </tr>
      <% }) %>
      <% if (maintenanceDue.length === 0) { %><tr><td colspan="6" class="empty-row">Nothing due for maintenance soon.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Fleet Reliability (MTBF, from Incidents with a Related Asset)</h2></div>
  <table class="table">
    <thead><tr><th>Robot / Equipment</th><th>Incident Count</th><th>First Incident</th><th>Last Incident</th><th>MTBF</th></tr></thead>
    <tbody>
      <% fleetReliability.forEach(function(f){ %>
        <tr>
          <td><%= f.relatedAsset %></td><td><%= f.incidentCount %></td>
          <td><%= f.firstIncident %></td><td><%= f.lastIncident %></td>
          <td><%= f.mtbfDays !== null ? f.mtbfDays + ' day(s)' : '—' %></td>
        </tr>
      <% }) %>
      <% if (fleetReliability.length === 0) { %><tr><td colspan="5" class="empty-row">No incidents have a Related Asset recorded yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="panel">
  <div class="panel-header"><h2>Finance &amp; Spend Overview (Purchase Orders + Expense Claims, by month)</h2></div>
  <table class="table">
    <thead><tr><th>Month</th><th>Purchase Spend</th><th>POs</th><th>Approved/Reimbursed Expenses</th><th>Claims</th><th>Total</th></tr></thead>
    <tbody>
      <% financeSpend.forEach(function(f){ %>
        <tr>
          <td><%= f.month %></td><td><%= f.purchaseAmount %></td><td><%= f.purchaseCount %></td>
          <td><%= f.expenseAmount %></td><td><%= f.expenseCount %></td><td><%= f.totalAmount %></td>
        </tr>
      <% }) %>
      <% if (financeSpend.length === 0) { %><tr><td colspan="6" class="empty-row">No purchase or expense data yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
