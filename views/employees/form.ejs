<%- include('../partials/header', { title: editing ? 'Edit Employee' : 'New Employee' }) %>

<div class="page-header">
  <h1><%= editing ? 'Edit Employee' : 'New Employee' %></h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<%
  const deptList = typeof departmentList !== "undefined" ? departmentList : [];
  const deptIsKnown = form.department && deptList.includes(form.department);
%>
<form class="panel form-panel" method="post" action="<%= editing ? '/employees/' + form._id : '/employees' %>" id="employee-form">
  <div class="form-grid">
    <label>Name
      <input type="text" name="name" value="<%= form.name || '' %>" required />
    </label>
    <label>Email
      <input type="email" name="email" value="<%= form.email || '' %>" required />
    </label>
    <label>Department
      <select id="employee-department-select" required>
        <option value="">— Select a department —</option>
        <% deptList.forEach(function(d) { %>
          <option value="<%= d %>" <%= form.department === d ? 'selected' : '' %>><%= d %></option>
        <% }) %>
        <option value="__other__" <%= (form.department && !deptIsKnown) ? 'selected' : '' %>>Other (type manually)…</option>
      </select>
    </label>
    <label id="employee-department-manual-label" style="<%= (form.department && !deptIsKnown) ? '' : 'display:none' %>">Department (type manually)
      <input type="text" id="employee-department-manual" value="<%= (form.department && !deptIsKnown) ? form.department : '' %>" />
    </label>
    <label>Location
      <input type="text" name="location" value="<%= form.location || '' %>" />
    </label>
    <label>Designation
      <input type="text" name="designation" value="<%= form.designation || '' %>" />
    </label>
    <label>Reports To (employee name)
      <input type="text" name="reportsTo" value="<%= form.reportsTo || '' %>" />
    </label>
    <label>Status
      <select name="status">
        <% Object.values(EMPLOYEE_STATUS).forEach(function(s){ %>
          <option value="<%= s %>" <%= (form.status || 'New') === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </label>
    <label>Employment Type
      <select name="employmentType" id="employmentType">
        <% Object.values(EMPLOYMENT_TYPE).forEach(function(t){ %>
          <option value="<%= t %>" <%= (form.employmentType || 'On-Roll') === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <label>Contract End Date <span class="hint">(Contract type only)</span>
      <input type="date" name="contractEndDate" value="<%= form.contractEndDate ? new Date(form.contractEndDate).toISOString().slice(0,10) : '' %>" />
    </label>
  </div>
  <% if (!editing) { %>
    <div class="alert alert-info">
      Setting Status to "New" automatically creates onboarding Service
      Requests, an Onboarding checklist, and a login for this person
      (Viewer role by default — an Admin can upgrade it afterward).
    </div>
  <% } %>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/employees">Cancel</a>
    <button type="submit" class="btn btn-primary"><%= editing ? 'Save Changes' : 'Add Employee' %></button>
  </div>
</form>

<script>
  (function () {
    var select = document.getElementById('employee-department-select');
    var manualLabel = document.getElementById('employee-department-manual-label');
    var manual = document.getElementById('employee-department-manual');
    var form = document.getElementById('employee-form');

    select.addEventListener('change', function () {
      if (select.value === '__other__') {
        manualLabel.style.display = '';
        manual.focus();
      } else {
        manualLabel.style.display = 'none';
      }
    });

    form.addEventListener('submit', function (evt) {
      var value = select.value === '__other__' ? manual.value.trim() : select.value;
      if (!value) {
        evt.preventDefault();
        alert('Please select a department, or choose "Other" and type one.');
        return;
      }
      var hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'department';
      hidden.value = value;
      form.appendChild(hidden);
    });
  })();
</script>

<%- include('../partials/footer') %>
