<%- include('../partials/header', { title: 'Recruitment' }) %>

<div class="page-header">
  <h1>Recruitment — Job Postings</h1>
  <a class="btn btn-primary" href="/recruitment/new">+ New Job Posting</a>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>ID</th><th>Title</th><th>Department</th><th>Status</th><th>Posted</th><th></th></tr></thead>
    <tbody>
      <% jobs.forEach(function(j) { %>
        <tr>
          <td><%= j.jobId %></td>
          <td><a href="/recruitment/<%= j.jobId %>/candidates"><%= j.title %></a></td>
          <td><%= j.department %></td>
          <td><span class="badge <%= j.status === 'Open' ? 'badge-status-open' : 'badge-status-closed' %>"><%= j.status %></span></td>
          <td><%= new Date(j.postedDate).toLocaleDateString() %></td>
          <td>
            <a class="btn btn-secondary" href="/recruitment/<%= j.jobId %>/candidates">Candidates</a>
            <% if (j.status === 'Open') { %>
              <form method="post" action="/recruitment/<%= j.jobId %>/close" style="display:inline">
                <button type="submit" class="btn btn-danger">Close</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (jobs.length === 0) { %><tr><td colspan="6" class="empty-row">No job postings yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
