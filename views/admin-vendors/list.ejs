<%- include('../partials/header', { title: 'Admin Vendor Management' }) %>

<div class="page-header">
  <h1>Admin Vendor Management</h1>
  <div class="header-actions">
    <a class="btn btn-secondary" href="/admin/ops">← Admin Ops Hub</a>
    <a class="btn btn-primary" href="/admin/vendors/new">+ Add Vendor</a>
  </div>
</div>

<%- include('../partials/csvActions', { moduleKey: 'adminVendor' }) %>

<p class="hint">Facilities &amp; office-services vendors — housekeeping, stationery, pantry, security, and AMC/contract services — separate from the IT Vendor directory.</p>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>Vendor Name</th><th>Contact</th><th>Email</th><th>Phone</th><th>Category</th><th>AMC Expiry</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% vendors.forEach(function(v) { %>
        <tr>
          <td><%= v.name %></td>
          <td><%= v.contactPerson || '—' %></td>
          <td><%= v.email || '—' %></td>
          <td><%= v.phone || '—' %></td>
          <td><%= v.category %></td>
          <td><%= v.amcExpiry ? new Date(v.amcExpiry).toLocaleDateString() : '—' %></td>
          <td><span class="badge <%= v.status === 'Active' ? 'badge-status-open' : 'badge-status-closed' %>"><%= v.status %></span></td>
          <td><a class="btn btn-secondary" href="/admin/vendors/<%= v._id %>/edit">Edit</a> <a class="btn btn-secondary" href="/admin-attachments/admin-vendors/<%= v._id %>" title="Attachments"><%- icon('paperclip', {size:14}) %></a></td>
        </tr>
      <% }) %>
      <% if (vendors.length === 0) { %><tr><td colspan="8" class="empty-row">No vendors yet.</td></tr><% } %>
    </tbody>
  </table>
  <%- include('../partials/pagination', { pageInfo }) %>
</div>

<%- include('../partials/footer') %>
