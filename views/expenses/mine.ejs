<%- include('../partials/header', { title: 'My Expense Claims' }) %>

<div class="page-header">
  <h1>My Expense Claims</h1>
  <a class="btn btn-primary" href="/expenses/new">+ Submit Expense Claim</a>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="panel">
  <table class="table">
    <thead><tr><th>Claim ID</th><th>Category</th><th>Amount</th><th>Expense Date</th><th>Status</th></tr></thead>
    <tbody>
      <% claims.forEach(function(c) { %>
        <tr>
          <td><%= c.claimId %></td>
          <td><%= c.category %></td>
          <td><%= c.amount %></td>
          <td><%= c.expenseDate ? new Date(c.expenseDate).toLocaleDateString() : '—' %></td>
          <td><span class="badge <%= c.status === 'Approved' || c.status === 'Reimbursed' ? 'badge-status-resolved' : (c.status === 'Rejected' ? 'badge-status-cancelled' : 'badge-status-open') %>"><%= c.status %></span></td>
        </tr>
      <% }) %>
      <% if (claims.length === 0) { %><tr><td colspan="5" class="empty-row">You haven't submitted any expense claims.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
