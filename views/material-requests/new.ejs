<%- include('../partials/header', { title: 'New Material Request' }) %>

<div class="page-header">
  <h1>New Material Request</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form class="panel form-panel" method="post" action="/material-requests">
  <div class="form-grid">
    <label>Item
      <select name="itemName" required>
        <option value="">Select…</option>
        <% items.forEach(function(i) { %>
          <option value="<%= i.itemName %>" <%= form.itemName === i.itemName ? 'selected' : '' %>><%= i.itemName %> (<%= i.itemId %>)</option>
        <% }) %>
      </select>
    </label>
    <label>Quantity
      <input type="number" name="quantity" min="1" value="<%= form.quantity || '' %>" required />
    </label>
    <label>Department
      <input type="text" name="department" list="departmentList" value="<%= form.department || '' %>" />
    </label>
  </div>
  <label>Purpose
    <textarea name="purpose" rows="2"><%= form.purpose || '' %></textarea>
  </label>
  <div class="form-actions">
    <a class="btn btn-secondary" href="/material-requests">Cancel</a>
    <button type="submit" class="btn btn-primary">Submit Request</button>
  </div>
</form>

<%- include('../partials/footer') %>
