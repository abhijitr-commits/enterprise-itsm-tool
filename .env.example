# Copy this file to .env and fill in your own values.

# MongoDB Atlas free-tier (M0) connection string.
# Get it from: Atlas dashboard -> your cluster -> "Connect" -> "Drivers"
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/enterprise_itsm?retryWrites=true&w=majority

# Any long random string — used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

PORT=3000

COMPANY_EMAIL_DOMAIN=peppermintrobotics.com

# Used only by `npm run seed` to create the first Administrator account.
SEED_ADMIN_EMAIL=admin@peppermintrobotics.com
SEED_ADMIN_PASSWORD=ChangeMe123!
